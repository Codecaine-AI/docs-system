{
  "name": "@codecaine-ai/docs-index",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Codecaine-AI/docs-system.git",
    "directory": "packages/docs-index"
  },
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./backlinks": "./src/backlinks.ts",
    "./ref-match": "./src/ref-match.ts",
    "./move-doc": "./src/move-doc.ts",
    "./paths": "./src/paths.ts",
    "./project-policy": "./src/project-policy.ts",
    "./subtree-guard": "./src/subtree-guard.ts",
    "./safe-path": "./src/safe-path.ts"
  },
  "dependencies": {
    "@codecaine-ai/canvas": "workspace:*",
    "@codecaine-ai/docs-model": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__tests__",
    "!src/**/__fixtures__",
    "!src/**/__snapshots__",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
