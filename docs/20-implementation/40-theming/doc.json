    "b-thm-impl-d-layers-decision": {
      "id": "b-thm-impl-d-layers-decision",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Decision: Each design precedence layer is realized as a distinct CSS mechanism — base values as static stylesheets ("
        },
        {
          "insert": "notion-palette.css",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " raw variables mapped by "
        },
        {
          "insert": "semantic.css",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "), the selected theme as one injected style element compiled from the theme folder with a light and a dark block, and style-rail state as inline custom properties on the root element."
        }
      ],
      "children": []
    },
    "b-thm-impl-d-layers-why": {
      "id": "b-thm-impl-d-layers-why",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Why: Merging the layers into one computed set at runtime was rejected — letting CSS arbitration (inline over injected over stylesheet) carry the design's precedence order means no application code re-implements it."
        }
      ],
      "children": []
    },
    "b-thm-impl-d-layers-applies": {
      "id": "b-thm-impl-d-layers-applies",
