    "b-fw-authority-d": {
      "id": "b-fw-authority-d",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Decision: The docs corpus is the canonical home of every structural rule; each standard under "
        },
        {
          "insert": "packages/framework/20-standards",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "packages/framework/20-standards"
            }
          }
        },
        {
          "insert": " is an operational copy ending in a literal "
        },
        {
          "insert": "Canonical:",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " pointer, and a structural change updates the corpus doc first and synchronizes the copy in the same change. The reference area stays a pointer stub holding no doctrine."
        }
      ],
      "children": []
    },
    "b-fw-authority-w": {
      "id": "b-fw-authority-w",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Why: Framework must not become a second decision-memory home. The copies are hand-maintained Markdown — a named deviation from the rendered-text agent contract — contained by the canonical pointers and same-change synchronization; a generator was rejected as machinery the deviation does not yet earn."
        }
      ],
      "children": []
    },
    "b-fw-authority-a": {
      "id": "b-fw-authority-a",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Applies to: "
        },
        {
          "insert": "packages/framework/20-standards",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "packages/framework/00-reference",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " — every future standard copy carries a canonical pointer."
        }
      ],
      "children": []
    },
