    "b-dv-mirror-w": {
      "id": "b-dv-mirror-w",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Why: Folder parity and registry closure prevent a model component or block type from silently becoming unreadable, and keep the central literals reviewable while the tests stop either side from drifting. Rejected: one central renderers file, which hides ownership and breaks the mirror."
        }
      ],
      "children": []
