    "b-dv-dep-h": {
      "id": "b-dv-dep-h",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "Model-only dependency; host actions leave through seams"
        }
      ],
      "children": []
    },
    "b-dv-dep-d": {
      "id": "b-dv-dep-d",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Decision: The package's only workspace dependency is docs-model; it imports no docs-index, docs-server, docs-workbench, filesystem, SQLite, or external engine code. Every host-dependent action — data reads, navigation, persistence, locks, uploads, canvas and sequence embeds — enters or leaves through the "
        },
        {
          "insert": "DocsClientProvider",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " seams and typed callbacks in "
        },
        {
          "insert": "packages/docs-viewer/src/client.tsx",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "packages/docs-viewer/src/client.tsx"
            }
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-dv-dep-w": {
      "id": "b-dv-dep-w",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Why: Browser purity in both directions keeps the format dependency-pure and the viewer liftable into an arbitrary React host. Rejected: importing transport, storage, or engines directly, which would weld the viewer to one host."
        }
      ],
      "children": []
    },
    "b-dv-dep-a": {
      "id": "b-dv-dep-a",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Applies to: "
        },
        {
          "insert": "packages/docs-viewer",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " — every future surface and capability; host-app imports are enforced by "
        },
        {
          "insert": "import-boundaries.test.ts",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "import-boundaries.test.ts"
            }
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-dv-ops-h": {
      "id": "b-dv-ops-h",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "The editor emits operations, never bytes"
