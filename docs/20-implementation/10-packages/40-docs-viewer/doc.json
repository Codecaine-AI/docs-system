        },
        {
          "insert": " owning its read descriptor and its "
        },
        {
          "insert": "editor-nodes.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " exports; the rich-text family subdivides one file per type inside its folder, and "
        },
        {
          "insert": "linked-panels",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the explicit shared primitive layer. "
        },
        {
          "insert": "packages/docs-viewer/src/__tests__/component-mirror.test.ts",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "packages/docs-viewer/src/__tests__/component-mirror.test.ts"
            }
          }
        },
        {
          "insert": " enforces exact folder parity with docs-model's "
        },
        {
          "insert": "ALL_COMPONENTS",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in both directions, the descriptor registry closes over "
        },
        {
          "insert": "DOC_BLOCK_TYPES",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "editor-nodes-sync.test.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " pins the node/block mappings. A new block component adds its viewer folder, descriptor, and node exports to pass."
