    "b-ec-mount-d": {
      "id": "b-ec-mount-d",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Decision: Canvas and Sequence mount as git submodules under "
        },
        {
          "insert": "external/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", keeping their own repositories, workspace roots, and tooling; the root "
        },
        {
          "insert": "package.json",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "package.json"
            }
          }
        },
        {
          "insert": " admits only "
        },
        {
          "insert": "external/canvas/packages/*",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "external/sequence/packages/*",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " into the Bun workspace so their inner packages resolve for consumers."
        }
      ],
      "children": []
    },
    "b-ec-mount-w": {
      "id": "b-ec-mount-w",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Why: The layout makes ownership literal — the docs system supports these projects but does not own them; moving either into "
        },
        {
          "insert": "packages/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " would falsely assign its engine and editor to the docs-system package graph. Rejected: vendoring the engines as first-party packages."
        }
      ],
      "children": []
    },
    "b-ec-mount-a": {
      "id": "b-ec-mount-a",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Applies to: "
        },
        {
          "insert": "external/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": ".gitmodules",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "package.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " — every future externally owned project mounts the same way."
        }
      ],
      "children": []
    },
    "b-ec-schema-h": {
      "id": "b-ec-schema-h",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "Only agent-schema crosses the pure-model wall"
        }
      ],
      "children": []
    },
    "b-ec-schema-d": {
      "id": "b-ec-schema-d",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Decision: docs-model imports nothing from either project except its "
        },
        {
          "insert": "agent-schema",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " leaf; lifted descriptors become forwarded actions handled by the owning authority, and the model never imports an engine. "
        },
        {
          "insert": "import-boundaries.test.ts",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "import-boundaries.test.ts"
            }
          }
        },
        {
          "insert": " enforces the restriction."
        }
      ],
      "children": []
    },
    "b-ec-schema-w": {
      "id": "b-ec-schema-w",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Why: Schema truth stays in the owning package without dragging its engine into the pure model. Rejected: redefining external operation schemas inside docs-model, which drifts from the authority."
        }
      ],
      "children": []
    },
    "b-ec-schema-a": {
      "id": "b-ec-schema-a",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Applies to: "
        },
        {
          "insert": "packages/docs-model",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "external/*/packages/*/src/agent-schema.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " — every future external authority exposes an agent-schema leaf and nothing more to the model."
        }
      ],
      "children": []
    },
    "b-ec-slots-h": {
      "id": "b-ec-slots-h",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "Engines enter only through host slots, and injection grants no authority"
        }
      ],
      "children": []
    },
    "b-ec-slots-d": {
      "id": "b-ec-slots-d",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Decision: docs-viewer never imports either engine; hosts inject renderers through the "
        },
        {
          "insert": "canvasEmbed",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "sequenceEmbed",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " provider slots, and injected surfaces are read-only — mutation routes through docs-server's typed patches or the standalone Studio's own hash-guarded save."
        }
      ],
      "children": []
    },
    "b-ec-slots-w": {
      "id": "b-ec-slots-w",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Why: The slot keeps the viewer liftable — another host may supply different loaders or renderers — and keeps mutation authority honest instead of leaking it into embeds. Rejected: a viewer engine dependency and embed-side writes."
        }
      ],
      "children": []
    },
    "b-ec-slots-a": {
      "id": "b-ec-slots-a",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Applies to: "
        },
        {
          "insert": "packages/docs-viewer",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "packages/docs-workbench/web/src/pages",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " — every future engine embed uses a provider slot and stays mutation-free."
        }
      ],
      "children": []
    },
    "b-ec-sidecar-h": {
      "id": "b-ec-sidecar-h",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
