    "b-ec-sidecar-d": {
      "id": "b-ec-sidecar-d",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Decision: Canvas and sequence documents are sidecar files in the docs tree — "
        },
        {
          "insert": ".canvas.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " under an "
        },
        {
          "insert": "assets/canvases/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " segment — confined and served by docs-server; Studio drafts stay separate, and opening a project board never creates a second authoritative copy in an engine-local store."
        }
      ],
      "children": []
    },
    "b-ec-sidecar-w": {
      "id": "b-ec-sidecar-w",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Why: One canonical home keeps hash preconditions, undo, and reference indexing meaningful. Rejected: storing project content in engine-local draft stores, which would fork authority."
        }
      ],
      "children": []
    },
    "b-ec-sidecar-a": {
      "id": "b-ec-sidecar-a",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Applies to: "
        },
        {
          "insert": "packages/docs-server/src/canvas-sidecar.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "packages/docs-server/src/sequence-sidecar.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", docs trees — every future sidecar kind keeps its canonical file in the repository."
        }
      ],
      "children": []
    }
