    "central-3": {
      "id": "central-3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A tag belongs to one repository. Docs System can release "
        },
        {
          "insert": "v0.0.2",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " while Canvas remains at "
        },
        {
          "insert": "v0.0.1",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Nested external repositories retain the version owned by their own product."
        }
      ],
      "children": []
    },
    "central-4": {
      "id": "central-4",
      "type": "structured-table",
      "props": {
        "columns": [
          "Identifier",
          "Meaning"
        ],
        "rows": [
          [
            "Product version",
            "The release version in the product's package manifests."
          ],
          [
            "Git tag and commit",
            "The immutable source snapshot selected for that product release."
          ],
          [
            "Development build hash",
            "The exact generated runtime artifact used by the local service, including uncommitted source changes."
          ],
          [
            "Document schema version",
            "The storage format and migration contract. It changes only when the format requires it."
          ],
          [
            "Signing identity",
            "The persistent certificate and application identifier used by macOS to recognize the executable."
          ]
        ]
      },
      "children": []
    },
    "central-5": {
      "id": "central-5",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "The Rule"
        }
      ],
      "children": []
    },
    "central-6": {
      "id": "central-6",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Change versions only for products included in a release. Update the product's owned package manifests together, including private tools and examples."
        }
      ],
      "children": []
    },
    "central-7": {
      "id": "central-7",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Keep released tags fixed. Publish corrections under a new version, with the changed behavior and compatibility requirements in the release notes."
        }
      ],
      "children": []
    },
    "central-8": {
      "id": "central-8",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Record the release commit and package inventory in the GitHub asset named "
        },
        {
          "insert": "<product>-<version>-manifest.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The asset describes the release tree, which can differ from a development checkout."
        }
      ],
      "children": []
    },
    "central-9": {
      "id": "central-9",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Keep "
        },
        {
          "insert": "workspace:*",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and existing local dependency references for development. A GitHub source release does not publish npm packages or prove compatibility with every linked checkout."
        }
      ],
      "children": []
    },
    "central-10": {
      "id": "central-10",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Choose subsequent version increments when planning each release. The "
        },
        {
          "insert": "0.0.1",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " baseline establishes independent ownership but does not define an approved pre-1.0 breaking-change policy."
        }
      ],
      "children": []
    },
    "central-11": {
      "id": "central-11",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Why"
        }
      ],
      "children": []
    },
    "central-12": {
      "id": "central-12",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Independent product versions allow each product to ship on its own schedule. Keeping the release version, development artifact, schema format, and signing identity distinct makes failures reproducible without treating every source edit as a release."
        }
      ],
      "children": []
    },
    "central-13": {
      "id": "central-13",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The initial GitHub releases provide source archives and package manifests. npm publication and automated release CI are separate work."
        }
      ],
      "children": []
    }
  }
}
