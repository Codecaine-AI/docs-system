    "central-0": {
      "id": "central-0",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Each Core product has its own release version, beginning at "
        },
        {
          "insert": "0.0.1",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Packages owned by that product share its version, so consumers can identify one coherent product release."
        }
      ],
      "children": []
    },
    "central-1": {
      "id": "central-1",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Structure"
        }
      ],
      "children": []
    },
