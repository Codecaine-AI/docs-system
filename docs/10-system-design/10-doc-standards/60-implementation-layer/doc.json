    "b-impl-intro-1": {
      "id": "b-impl-intro-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The implementation layer concisely maps the system design to the current codebase: how the code realizes the design, how it is organized, and why key implementation choices were made. An agent whose change conflicts with a recorded structural decision files a proposal; it never silently deviates."
        }
      ],
      "children": []
    },
