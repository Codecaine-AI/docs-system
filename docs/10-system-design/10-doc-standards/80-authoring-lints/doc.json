    "b-80-authoring-lints-shared-rules-let-cli-che-45": {
      "id": "b-80-authoring-lints-shared-rules-let-cli-che-45",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Shared rules let CLI checks and agent tools report the same evidence and repair guidance. Completion checks require new errors to be repaired at the supported completion boundaries. The docs MCP gates only warnings a task introduced, so an agent repairs its own violations without inheriting existing findings. Filler and sentence length stay ungated so a phrase match or word count cannot overrule a correct quotation, precise term, or useful explanation."
        }
      ],
      "children": []
