      "id": "b-70-document-purpose-answer-a-bounded-why-que-11",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Answer a bounded why question with context, constraints, alternatives, and reasons for a decision."
        }
      ],
      "children": []
    },
