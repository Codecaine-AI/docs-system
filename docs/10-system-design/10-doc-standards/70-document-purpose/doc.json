      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Templates define the page's shape. Purpose determines what belongs inside that shape."
        }
      ],
      "children": []
    },
    "b-70-document-purpose-match-the-detail-to-the-23": {
      "id": "b-70-document-purpose-match-the-detail-to-the-23",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Match the detail to the task."
        }
      ],
      "children": [
        "b-70-document-purpose-tutorials-show-visible-r-24",
        "b-70-document-purpose-reference-presents-facts-25"
      ]
    },
    "b-70-document-purpose-tutorials-show-visible-r-24": {
      "id": "b-70-document-purpose-tutorials-show-visible-r-24",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Tutorials show visible results and link extended explanation. How-to guides assume competence and omit lessons unrelated to the task."
        }
      ],
      "children": []
    },
    "b-70-document-purpose-reference-presents-facts-25": {
      "id": "b-70-document-purpose-reference-presents-facts-25",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Reference presents facts for lookup. Explanation weighs alternatives and states the reasoning."
        }
      ],
      "children": []
    },
    "b-70-document-purpose-why-26": {
      "id": "b-70-document-purpose-why-26",
      "type": "heading",
      "props": {
