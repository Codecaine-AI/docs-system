    },
    "b-70-document-purpose-foundation-owns-intent-15": {
      "id": "b-70-document-purpose-foundation-owns-intent-15",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Foundation owns intent. Design owns behavior. Agents owns agent definitions. Implementation maps the design to current code and explains key implementation choices."
        }
      ],
      "children": []
    },
    "b-70-document-purpose-procedure-belongs-in-an-16": {
      "id": "b-70-document-purpose-procedure-belongs-in-an-16",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Procedure belongs in an existing, declared guides tier. Do not create new root categories merely to match Diataxis."
        }
      ],
      "children": []
    },
    "b-70-document-purpose-keep-one-main-reader-tas-17": {
      "id": "b-70-document-purpose-keep-one-main-reader-tas-17",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Keep one main reader task per page."
        }
      ],
      "children": [
        "b-70-document-purpose-a-standard-can-state-a-r-18",
        "b-70-document-purpose-split-and-link-when-a-se-19"
      ]
    },
    "b-70-document-purpose-a-standard-can-state-a-r-18": {
      "id": "b-70-document-purpose-a-standard-can-state-a-r-18",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "A standard can state a rule and explain why. A how-to can include a small reference detail needed for its next step."
        }
      ],
      "children": []
    },
    "b-70-document-purpose-split-and-link-when-a-se-19": {
      "id": "b-70-document-purpose-split-and-link-when-a-se-19",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Split and link when a secondary purpose becomes an independently useful page or interrupts the main task."
        }
      ],
      "children": []
    },
    "b-70-document-purpose-keep-the-established-sta-20": {
      "id": "b-70-document-purpose-keep-the-established-sta-20",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Keep the established standard flow of Structure, The Rule, and Why."
        }
      ],
      "children": [
        "b-70-document-purpose-keep-implementation-area-21",
        "b-70-document-purpose-templates-define-the-pag-22"
      ]
    },
