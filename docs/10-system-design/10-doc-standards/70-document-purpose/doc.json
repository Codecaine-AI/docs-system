    "b-70-document-purpose-help-a-learner-build-som-5": {
      "id": "b-70-document-purpose-help-a-learner-build-som-5",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Help a learner build something through a controlled sequence. State the result at the start and show expected output throughout."
        }
      ],
      "children": []
    },
    "b-70-document-purpose-how-to-6": {
      "id": "b-70-document-purpose-how-to-6",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "How-To",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "b-70-document-purpose-help-a-competent-reader-7"
      ]
    },
    "b-70-document-purpose-help-a-competent-reader-7": {
      "id": "b-70-document-purpose-help-a-competent-reader-7",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Help a competent reader finish a task. Use direct steps, relevant conditions, and decision points. Name the guide by the task."
        }
      ],
      "children": []
    },
    "b-70-document-purpose-reference-8": {
      "id": "b-70-document-purpose-reference-8",
