    "b-70-document-purpose-every-document-has-one-p-1": {
      "id": "b-70-document-purpose-every-document-has-one-p-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Every document has one primary reader purpose within the corpus's existing layers. Supporting reasons and reference details belong when they help the reader finish that purpose."
        }
      ],
      "children": []
    },
    "b-70-document-purpose-structure-2": {
