      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Keep implementation area pages and decision entries in the "
        },
        {
          "insert": "Implementation Layer",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "docs/10-system-design/10-doc-standards/60-implementation-layer"
