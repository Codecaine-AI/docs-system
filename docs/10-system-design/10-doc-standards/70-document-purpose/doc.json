    },
    "b-70-document-purpose-diataxis-distinguishes-f-3": {
      "id": "b-70-document-purpose-diataxis-distinguishes-f-3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Diataxis distinguishes four purposes by whether the reader needs action or understanding, for learning or for work."
        }
      ],
      "children": []
    },
    "b-70-document-purpose-tutorial-4": {
      "id": "b-70-document-purpose-tutorial-4",
