    "b-70-document-purpose-choose-the-primary-purpo-13": {
      "id": "b-70-document-purpose-choose-the-primary-purpo-13",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Choose the primary purpose before authoring. Purpose guides the reader's task; the corpus layers still determine location and authority."
        }
      ],
      "children": []
    },
    "b-70-document-purpose-preserve-the-three-layer-14": {
      "id": "b-70-document-purpose-preserve-the-three-layer-14",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Preserve the four layers and the templates defined in "
        },
        {
          "insert": "Structure",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "docs/10-system-design/10-doc-standards/10-structure"
            }
          }
        },
        {
          "insert": "."
        }
      ],
      "children": [
        "b-70-document-purpose-foundation-owns-intent-15",
