            "bold": true
          }
        }
      ],
      "children": [
        "b-70-document-purpose-supply-facts-for-lookup-9"
      ]
    },
    "b-70-document-purpose-supply-facts-for-lookup-9": {
      "id": "b-70-document-purpose-supply-facts-for-lookup-9",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Supply facts for lookup. Mirror the thing described and state its options, limits, and errors. Generate facts from code where practical."
        }
      ],
      "children": []
    },
    "b-70-document-purpose-explanation-10": {
      "id": "b-70-document-purpose-explanation-10",
