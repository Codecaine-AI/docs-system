          "index": 11,
          "props": {},
          "text": [
            {
              "insert": "Start with the section overview, descend into the relevant package or module, and follow its source links. File headers explain responsibilities and invariants; function comments explain contracts; inline comments explain local decisions. Documentation depth follows the explanation rather than a fixed three-level ceiling."
            }
