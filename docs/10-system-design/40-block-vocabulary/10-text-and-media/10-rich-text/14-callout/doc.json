      "id": "b-15-callout-agent-0-decision-pattern",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Decision records are two parts: a short dated callout stating the call, then an H3 section holding the reasoning and consequences. The callout stays greppable; the section carries the why."
        }
