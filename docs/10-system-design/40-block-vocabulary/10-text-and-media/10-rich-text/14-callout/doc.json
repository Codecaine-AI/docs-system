        }
      ],
      "children": []
    },
    "b-15-callout-example-intro-21": {
      "id": "b-15-callout-example-intro-21",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The five supported tones are info, decision, risk, warning, and success. Each example shows the tone icon beside an optional title, with a plain body below. The read view prints no type label. Hovering the icon shows the type name, which is "
        },
        {
          "insert": "kind",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " when set and the tone name otherwise."
        }
      ],
      "children": []
    },
    "b-15-callout-example-info-22": {
      "id": "b-15-callout-example-info-22",
      "type": "callout",
      "props": {
        "tone": "info"
      },
      "text": [
        {
          "insert": "Tone only, the agent render labels this "
        },
        {
          "insert": "INFO",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "callout-example-decision": {
      "id": "callout-example-decision",
      "type": "callout",
      "props": {
        "title": "Keep the original available",
        "tone": "decision"
      },
      "text": [
        {
          "insert": "Retain the captured source and review history so the selected design can be compared with its starting point."
        }
      ],
      "children": []
    },
    "callout-example-risk": {
      "id": "callout-example-risk",
      "type": "callout",
      "props": {
        "title": "Source may have changed",
        "tone": "risk"
      },
      "text": [
        {
          "insert": "A source edit made after capture can conflict with the selected revision. Compare the current file before integrating the design."
        }
      ],
      "children": []
    },
