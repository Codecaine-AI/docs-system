      "props": {
        "title": "Tab opens with a rule",
        "tone": "success",
        "variant": "tab"
      },
      "text": [
        {
          "insert": "A thin tone rule runs across the top with the icon notched into it, and a faint tint fills below. Pick it when the callout heads a short run of related content."
