    "callout-styles-intro": {
      "id": "callout-styles-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Set "
        },
        {
          "insert": "props.variant",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " to pick one of four styles per block. "
        },
        {
          "insert": "eyebrow",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the default, and a missing or unknown value renders as "
        },
        {
          "insert": "eyebrow",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Every style keeps the tone color and icon and changes only the frame."
