    "b-15-callout-lead-2": {
      "id": "b-15-callout-lead-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Callout highlights short contextual information, including decisions, risks, warnings, and outcomes. It also provides the vocabulary's safety net: retired or unknown block types become callouts rather than failing validation."
        }
      ],
      "children": []
    },
    "b-15-callout-example-h-20": {
      "id": "b-15-callout-example-h-20",
      "type": "heading",
