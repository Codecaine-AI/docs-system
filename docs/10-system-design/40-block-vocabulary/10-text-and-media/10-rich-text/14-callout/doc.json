      "props": {
        "description": "Closed schema. All four props are optional.",
        "example": "{\n  \"tone\": \"warning\",\n  \"kind\": \"Boundary under review\",\n  \"title\": \"Vocabulary growth\",\n  \"variant\": \"hairline\"\n}",
        "fields": [
          {
            "name": "tone",
            "type": "\"info\" | \"decision\" | \"risk\" | \"warning\" | \"success\"",
            "required": false,
            "description": "Sets the color of the rail, icon, and label. Without a kind, the printed label is the tone name, and the agent render falls back to the uppercased tone (default INFO)."
