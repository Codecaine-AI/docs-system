      "id": "b-15-callout-coercion-9",
      "type": "callout",
      "props": {
        "kind": "Decision",
        "title": "Retired types never break a corpus",
        "tone": "decision"
      },
      "text": [
        {
          "insert": "After legacy "
        },
        {
          "insert": "flavour",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " aliasing, any block whose type is a string but not one of the canonical block types coerces to a callout, preserving the old type name as "
        },
        {
          "insert": "props.kind",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " (unless the block already carries its own non-empty "
        },
        {
          "insert": "kind",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "). Props, text, and children carry over verbatim, and the block canonicalizes to the coerced form on its next save. One render rule covers them all."
        }
      ],
      "children": []
    },
