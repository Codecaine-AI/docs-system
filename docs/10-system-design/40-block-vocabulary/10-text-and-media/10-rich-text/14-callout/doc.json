    "b-15-callout-agent-0-length": {
      "id": "b-15-callout-agent-0-length",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Keep the body to one or two sentences, the labeled fact itself. Mechanics, rationale, history, and examples go in a heading-led section ("
