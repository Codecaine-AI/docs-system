    "callout-style-eyebrow": {
      "id": "callout-style-eyebrow",
      "type": "callout",
      "props": {
        "title": "Eyebrow is the default",
        "tone": "info",
        "variant": "eyebrow"
      },
      "text": [
        {
          "insert": "A colored left rail and a faint tone tint frame the callout, with the icon beside the title. Pick it for most callouts."
        }
      ],
      "children": []
    },
    "callout-style-hairline": {
      "id": "callout-style-hairline",
      "type": "callout",
      "props": {
        "title": "Hairline separates without a fill",
        "tone": "decision",
        "variant": "hairline"
      },
      "text": [
        {
          "insert": "The icon sits in its own column behind a thin tone-tinted line, with no background. Pick it for dense pages where a quiet divider is enough."
        }
      ],
      "children": []
    },
    "callout-style-rail": {
      "id": "callout-style-rail",
      "type": "callout",
      "props": {
        "title": "Rail marks the edge",
        "tone": "warning",
        "variant": "rail"
      },
      "text": [
        {
          "insert": "The icon sits in its own column left of a thicker, solid tone rail, with no background. Pick it over hairline when the callout needs a stronger edge but should stay unfilled."
        }
      ],
      "children": []
    },
    "callout-style-tab": {
      "id": "callout-style-tab",
