            "name": "title",
            "type": "string",
            "required": false,
            "description": "Optional bold title after the label."
          },
          {
            "name": "variant",
            "type": "\"eyebrow\" | \"hairline\" | \"rail\" | \"tab\"",
            "required": false,
            "description": "Stored and stamped as data-callout-variant. Every variant renders the same note. A missing or unknown value reads as eyebrow, and the agent render ignores it."
          }
        ],
