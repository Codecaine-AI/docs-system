    "b-15-callout-state-shape-25": {
      "id": "b-15-callout-state-shape-25",
      "type": "state-shape",
      "props": {
        "description": "Closed schema. All four props are optional.",
        "example": "{\n  \"tone\": \"warning\",\n  \"kind\": \"Boundary under review\",\n  \"title\": \"Vocabulary growth\",\n  \"variant\": \"hairline\"\n}",
        "fields": [
          {
            "name": "tone",
            "type": "\"info\" | \"decision\" | \"risk\" | \"warning\" | \"success\"",
            "required": false,
            "description": "Color/intent; the agent render's label falls back to the uppercased tone (default INFO)."
          },
          {
            "name": "kind",
            "type": "string",
            "required": false,
            "description": "Free-form type name. Wins over tone in the agent render and the icon tooltip. Coerced legacy types land their old type name here."
          },
          {
            "name": "title",
            "type": "string",
            "required": false,
            "description": "Optional bold title after the label."
          },
          {
            "name": "variant",
            "type": "\"eyebrow\" | \"hairline\" | \"rail\" | \"tab\"",
            "required": false,
            "description": "Visual style of the frame. A missing or unknown value renders as eyebrow, the default. The agent render ignores it."
          }
        ],
        "name": "CalloutState",
        "source": {
          "path": "packages/docs-model/src/components/rich-text/state.ts",
          "symbol": "CalloutState"
        }
      },
      "children": []
    },
