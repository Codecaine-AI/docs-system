      "props": {
        "description": "Closed schema with two optional props, ordered and checked.",
        "example": "{\n  \"ordered\": true,\n  \"checked\": false\n}",
        "fields": [
          {
            "name": "ordered",
            "type": "boolean",
            "required": false,
            "description": "true renders a numbered item; absent or false renders a bullet."
          },
          {
            "name": "checked",
            "type": "boolean",
            "required": false,
            "description": "Task state. Absent renders an ordinary item, false an open task, and true a done task. It works with ordered."
