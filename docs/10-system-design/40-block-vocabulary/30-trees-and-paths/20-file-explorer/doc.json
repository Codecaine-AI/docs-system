        {
          "insert": "File Tree",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/40-block-vocabulary/30-trees-and-paths/10-file-tree"
            }
          }
        },
        {
          "insert": " draws the same entry shape as a plain-text "
        },
        {
          "insert": "tree",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " listing."
        }
