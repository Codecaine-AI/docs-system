    "fx-w-notes-1": {
      "id": "fx-w-notes-1",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Give a note one fact about what the file does, in about 10 words, so it fits on one line. Where a build or an installer copies the file is not what it does."
        }
      ],
      "children": []
    },
    "fx-w-notes-2": {
      "id": "fx-w-notes-2",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Never restate the file name, the path, or the change in a note, and never point to another row with \"same\" or \"above\"."
        }
