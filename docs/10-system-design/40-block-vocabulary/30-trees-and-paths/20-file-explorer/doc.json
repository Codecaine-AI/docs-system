    "fx-act-surface": {
      "id": "fx-act-surface",
      "type": "interaction-surface",
      "props": {
        "operations": [
          {
            "name": "file-explorer.addEntry",
            "description": "Append a path entry (optional note, change marker, and color) to the file explorer.",
            "params": [
              {
                "name": "path",
                "type": "string",
                "required": true,
                "description": "/-separated path, no leading \"./\". A trailing \"/\" marks an explicit directory."
              },
              {
                "name": "note",
                "type": "string",
                "required": false,
                "description": "Short annotation rendered after the path."
              },
              {
                "name": "change",
                "type": "\"added\" | \"removed\" | \"modified\" | \"renamed\"",
                "required": false,
                "description": "Change marker for the entry."
              },
              {
                "name": "color",
                "type": "\"gray\" | \"red\" | \"orange\" | \"yellow\" | \"green\" | \"teal\" | \"blue\" | \"violet\" | \"pink\"",
                "required": false,
                "description": "Group color. A directory's color carries to its whole subtree."
              }
            ],
            "returns": "Props patch { entries }, revalidated against FileExplorerState",
            "kind": "action"
          },
          {
            "name": "file-explorer.updateEntry",
            "description": "Patch an entry's note, change, from, or color, or rename it in place with newPath.",
            "params": [
              {
                "name": "path",
                "type": "string",
                "required": true,
                "description": "Exact path of the entry to patch."
              },
              {
                "name": "note",
                "type": "string | null",
                "required": false,
                "description": "New note. Pass null to clear."
              },
              {
                "name": "change",
                "type": "\"added\" | \"removed\" | \"modified\" | \"renamed\" | null",
                "required": false,
                "description": "New change marker. Pass null to clear."
              },
              {
                "name": "from",
                "type": "string | null",
                "required": false,
                "description": "Previous path for a renamed entry. Pass null to clear."
              },
              {
                "name": "color",
                "type": "\"gray\" | \"red\" | \"orange\" | \"yellow\" | \"green\" | \"teal\" | \"blue\" | \"violet\" | \"pink\" | null",
                "required": false,
                "description": "New group color. Pass null to clear."
              },
              {
                "name": "newPath",
                "type": "string",
                "required": false,
                "description": "Rename the entry to this path, kept in place."
              }
            ],
            "returns": "Props patch { entries }, revalidated against FileExplorerState",
            "kind": "action"
          },
          {
            "name": "file-explorer.removeEntry",
            "description": "Remove the entry with the given path from the file explorer.",
            "params": [
              {
                "name": "path",
                "type": "string",
                "required": true,
                "description": "Exact path of the entry to remove."
              }
            ],
            "returns": "Props patch { entries }, revalidated against FileExplorerState",
            "kind": "action"
          }
        ]
      },
