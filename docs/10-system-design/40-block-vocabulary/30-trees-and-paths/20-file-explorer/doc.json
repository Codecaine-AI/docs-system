    "fx-w-marks-1": {
      "id": "fx-w-marks-1",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Set "
        },
        {
          "insert": "change",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " only for a real change in the change the page describes."
        }
      ],
      "children": []
    },
    "fx-w-marks-2": {
      "id": "fx-w-marks-2",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A stage, an owner, or a key file is never a change, so a page about a folder with no change sets no "
        },
        {
          "insert": "change",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "fx-w-marks-3": {
      "id": "fx-w-marks-3",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Set "
        },
        {
          "insert": "color",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " only on a group that the prose names, and say in the prose what each color marks. Color is a second cue, so when the brief asks for the group, such as the stage that writes a file, also name it in each note."
        }
      ],
      "children": []
    },
    "fx-w-marks-4": {
      "id": "fx-w-marks-4",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Give two groups hues far apart, such as blue and pink, and never green, red, or yellow, because they read as change colors."
        }
      ],
      "children": []
    },
