      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The file-explorer component owns one block type, "
        },
        {
          "insert": "file-explorer",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", which draws flat path entries as IDE-style sidebar rows with collapsible folders and a badge per changed file. Use it to show the files a change touches. "
