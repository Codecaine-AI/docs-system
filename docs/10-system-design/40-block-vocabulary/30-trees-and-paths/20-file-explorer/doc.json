    "fx-intro": {
      "id": "fx-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The file-explorer component owns one block type, "
        },
        {
          "insert": "file-explorer",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", which draws flat path entries as IDE-style sidebar rows. Folders collapse, and each changed file gets a gutter glyph, with a key under the rows that names each glyph. Use it to show the files a change touches. "
        },
        {
          "insert": "File Tree",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/40-block-vocabulary/30-trees-and-paths/10-file-tree"
            }
          }
        },
        {
          "insert": " draws the same entry shape as a plain-text "
        },
        {
          "insert": "tree",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " listing."
        }
      ],
      "children": []
    },
