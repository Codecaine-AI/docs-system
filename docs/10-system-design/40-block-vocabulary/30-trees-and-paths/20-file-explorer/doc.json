    "fx-state-shape": {
      "id": "fx-state-shape",
      "type": "state-shape",
      "props": {
        "fields": [
          {
            "name": "entries",
            "type": "FileTreeEntry[]",
            "description": "Flat path entries. Folders derive from path prefixes.",
            "fields": [
              {
                "name": "path",
                "type": "string",
                "description": "/-separated, no leading \"./\". A trailing \"/\" marks a directory."
              },
              {
                "name": "note",
                "type": "string",
                "required": false,
                "description": "One muted line after the name."
              },
              {
                "name": "change",
                "type": "\"added\" | \"removed\" | \"modified\" | \"renamed\"",
                "required": false,
                "description": "Colors the name and adds an A, D, M, or R badge."
              },
              {
                "name": "from",
                "type": "string",
                "required": false,
                "description": "Previous path when renamed."
              }
            ]
          },
          {
            "name": "title",
            "type": "string",
            "required": false,
            "description": "Header title. No header renders without it."
          },
          {
            "name": "maxRows",
            "type": "integer (>= 1)",
            "required": false,
            "description": "Rows shown before folding (default 8)."
