    "ct-rows-lead": {
      "id": "ct-rows-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Each row copies its render site, so a reader can match the tree to the source files row by row. A tree that rewrites a condition, drops a guard or invents a row misleads that reader."
        }
      ],
      "children": []
    },
    "ct-rows-g1": {
      "id": "ct-rows-g1",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Row Text",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "ct-rows-g1-1",
        "ct-rows-g1-2",
        "ct-rows-g1-3",
        "ct-rows-g1-4",
        "ct-rows-g1-5",
        "ct-rows-g1-6"
      ]
    },
    "ct-rows-g1-1": {
      "id": "ct-rows-g1-1",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Copy each component row from the JSX at its render site, such as "
        },
        {
          "insert": "<TreeHead icon={head.icon} title={head.title} />",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Write a row that has child rows as an opening tag, and a leaf row as a self-closing tag."
        }
      ],
      "children": []
    },
    "ct-rows-g1-2": {
      "id": "ct-rows-g1-2",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Keep at most 3 props on a row, the ones that pass data, children or a render callback to a row in the tree. Drop the other props with no marker, because a bare "
        },
        {
          "insert": "…",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is not valid JSX."
        }
      ],
      "children": []
    },
    "ct-rows-g1-3": {
      "id": "ct-rows-g1-3",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Write a conditional, long or utility-class prop value as "
        },
        {
          "insert": "{…}",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", such as "
        },
        {
          "insert": "className={…}",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for "
        },
        {
          "insert": "p-3 text-ui-lg",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Keep a class name that names the part, such as "
        },
        {
          "insert": "docs-tree__note",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "ct-rows-g1-4": {
      "id": "ct-rows-g1-4",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Put a child that a parent renders through a callback prop, such as "
        },
        {
          "insert": "renderCanvas={renderCanvas}",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", under the component that calls the callback. Keep that prop on the parent row."
        }
      ],
      "children": []
    },
    "ct-rows-g1-5": {
      "id": "ct-rows-g1-5",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Draw a child that reaches the tree by 2 paths, such as a provider slot and a render callback, under each parent that creates it. Give each copy the source line of its own path."
        }
      ],
      "children": []
    },
    "ct-rows-g1-6": {
      "id": "ct-rows-g1-6",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Write an intrinsic leaf that shows text with that text and its closing tag, such as "
        },
        {
          "insert": "<div className={…}>Loading tree...</div>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "ct-rows-g2": {
      "id": "ct-rows-g2",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Branches",
          "attributes": {
