    "ct-example-lead": {
      "id": "ct-example-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "This tree is the panel that "
        },
        {
          "insert": "OutlineRows",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in "
        },
        {
          "insert": "packages/docs-viewer/src/components/outline-rows/OutlineRows.tsx",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " draws for a component-tree block. The root's source is its definition, and every other source is the line that renders the row. The tree leaves out the "
        },
        {
          "insert": "section",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "figure",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and rows "
        },
        {
          "insert": "div",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " wrappers, because no part the reader needs hangs off them."
        }
      ],
      "children": []
    },
