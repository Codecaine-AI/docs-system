    "ct-intro": {
      "id": "ct-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The component-tree component owns one block type, "
        },
        {
          "insert": "component-tree",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", a nested render tree that shows which component renders which. Each node is one code row with tree guides, an aligned comment column, a diff gutter and a source chip. A row is a rendered element or a branch. Add a hook row only when the page is about that hook, and use call stack for plain function calls."
        }
      ],
      "children": []
    },
    "ct-h-example": {
      "id": "ct-h-example",
