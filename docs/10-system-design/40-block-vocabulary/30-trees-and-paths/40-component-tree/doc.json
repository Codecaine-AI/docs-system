    "ct-rows-g2-2": {
      "id": "ct-rows-g2-2",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Give each arm of an if/else, a ternary or an early-return chain its own branch row. Write each later test in a chain as "
        },
        {
          "insert": "else if",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " plus its condition, and the last arm as "
        },
        {
          "insert": "else",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", or as "
        },
        {
          "insert": "default",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in a switch."
        }
      ],
      "children": []
    },
    "ct-rows-g2-3": {
      "id": "ct-rows-g2-3",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Nest an inner condition's branch rows under the outer branch row, as the source nests them. Each row's guards then read from its ancestors."
        }
      ],
      "children": []
    },
    "ct-rows-g2-4": {
      "id": "ct-rows-g2-4",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "In a chain of 3 or more arms, keep an arm that renders nothing as a branch row with no children and the comment "
        },
        {
          "insert": "renders nothing",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "ct-rows-g3": {
