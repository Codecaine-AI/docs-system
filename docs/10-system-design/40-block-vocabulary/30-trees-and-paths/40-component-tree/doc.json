    "ct-rows-g2-1": {
      "id": "ct-rows-g2-1",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Write a branch row's text as the source's own condition, not a paraphrase. Write a switch case as its full comparison, such as "
        },
        {
          "insert": "props.selectedId === \"theme.presets\"",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", never as a bare "
