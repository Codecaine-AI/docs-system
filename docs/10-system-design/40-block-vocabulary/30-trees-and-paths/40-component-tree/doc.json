    "ct-act-surface": {
      "id": "ct-act-surface",
      "type": "interaction-surface",
      "props": {
        "operations": [
          {
            "name": "component-tree.insertRow",
            "kind": "action",
            "description": "Insert a node row (with optional nested `nodes`) at an index path: the last element is the insert position among the addressed sibling list, preceding elements walk `nodes` from the root.",
            "params": [
              {
                "name": "path",
                "type": "integer[]",
                "required": true,
                "description": "Index path. [i] inserts at position i among the roots, [a, ..., i] at position i under the node addressed by the prefix."
              },
              {
                "name": "row",
                "type": "ComponentTreeRow",
                "required": true
              }
            ],
            "returns": "Props patch { nodes }, revalidated against ComponentTreeState"
          },
          {
            "name": "component-tree.updateRow",
            "kind": "action",
            "description": "Patch the node row at an index path. Omitted fields stay. Null clears an optional field. Nested `nodes` are untouched.",
            "params": [
              {
                "name": "path",
                "type": "integer[]",
                "required": true,
                "description": "Index path of the node, e.g. [0, 2] for the third child of the first root."
              },
              {
                "name": "patch",
                "type": "object",
                "required": true,
                "description": "Partial row. Null clears an optional field.",
                "fields": [
                  {
                    "name": "text",
                    "type": "string",
                    "required": false,
                    "description": "Replacement row text, written as code."
                  },
                  {
                    "name": "kind",
                    "type": "\"component\" | \"hook\" | \"branch\" | null",
                    "required": false,
                    "description": "Row kind (\"component\" | \"hook\" | \"branch\"). Null clears it."
                  },
                  {
                    "name": "comment",
                    "type": "string | null",
                    "required": false,
                    "description": "Aligned comment. Null clears it."
                  },
                  {
                    "name": "change",
                    "type": "\"added\" | \"modified\" | \"removed\" | null",
                    "required": false,
                    "description": "Diff state (\"added\" | \"modified\" | \"removed\"). Null clears it."
                  },
                  {
                    "name": "source",
                    "type": "string | null",
                    "required": false,
                    "description": "Source location \"path:line\". Null clears it."
                  }
                ]
              }
            ],
            "returns": "Props patch { nodes }, revalidated against ComponentTreeState"
          },
          {
            "name": "component-tree.removeRow",
            "kind": "action",
            "description": "Remove the node row at an index path, together with its nested `nodes`.",
            "params": [
              {
                "name": "path",
                "type": "integer[]",
                "required": true,
                "description": "Index path of the node to remove, e.g. [0, 2]."
              }
            ],
            "returns": "Props patch { nodes }, revalidated against ComponentTreeState"
          },
          {
            "name": "component-tree.moveRow",
            "kind": "action",
            "description": "Move the node row at `from` (with its nested `nodes`) to the insert position `to`. `to` is interpreted against the tree AFTER the row is removed.",
            "params": [
              {
                "name": "from",
                "type": "integer[]",
                "required": true,
                "description": "Index path of the node to move."
              },
              {
                "name": "to",
                "type": "integer[]",
                "required": true,
                "description": "Insertion index path (last element = insert position), resolved after the row is detached."
              }
            ],
            "returns": "Props patch { nodes }, revalidated against ComponentTreeState"
          },
          {
            "name": "component-tree.setRows",
            "kind": "action",
            "description": "Bulk replace: swap the entire node tree for the given rows.",
            "params": [
              {
                "name": "rows",
                "type": "ComponentTreeRow[]",
                "required": true,
                "description": "Complete replacement node tree (nested via `nodes`). An empty array empties the block."
              }
            ],
            "returns": "Props patch { nodes }, revalidated against ComponentTreeState"
          }
        ]
      },
      "children": []
    },
