          "insert": "docs_apply_ops",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " request from the MCP tool down to the file write. Each guard that returns early is a branch frame with its "
        },
        {
          "insert": "return",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " nested under it. The stack leaves out the draft-lock guard and the lint guard in "
        },
        {
          "insert": "applyDocOpsToBundle",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
