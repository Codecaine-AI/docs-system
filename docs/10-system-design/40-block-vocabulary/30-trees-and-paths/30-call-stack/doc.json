    "cs-act-surface": {
      "id": "cs-act-surface",
      "type": "interaction-surface",
      "props": {
        "operations": [
          {
            "name": "call-stack.insertRow",
            "description": "Insert a frame row (with optional nested `frames`) at an index path: the last element is the insert position among the addressed sibling list, preceding elements walk `frames` from the root.",
            "params": [
              {
                "name": "path",
                "type": "integer[]",
                "required": true,
                "description": "Index path. [i] inserts at position i among the roots, [a, ..., i] at position i under the frame addressed by the prefix."
              },
              {
                "name": "row",
                "type": "CallStackRow",
                "required": true
              }
            ],
            "returns": "Props patch { frames }, revalidated against CallStackState",
            "kind": "action"
          },
          {
            "name": "call-stack.updateRow",
            "description": "Patch the frame row at an index path. Omitted fields stay. Null clears an optional field. Nested `frames` are untouched.",
            "params": [
              {
                "name": "path",
                "type": "integer[]",
                "required": true,
                "description": "Index path of the frame, e.g. [0, 2] for the third child of the first root."
              },
              {
                "name": "patch",
                "type": "object",
                "required": true,
                "description": "Partial row. Null clears an optional field.",
                "fields": [
                  {
                    "name": "text",
                    "type": "string",
                    "required": false,
                    "description": "Replacement row text, written as code."
                  },
                  {
                    "name": "kind",
                    "type": "\"call\" | \"branch\" | null",
                    "required": false,
                    "description": "Row kind (\"call\" | \"branch\"). Null clears it."
                  },
                  {
                    "name": "comment",
                    "type": "string | null",
                    "required": false,
                    "description": "Aligned comment. Null clears it."
                  },
                  {
                    "name": "change",
                    "type": "\"added\" | \"modified\" | \"removed\" | null",
                    "required": false,
                    "description": "Diff state (\"added\" | \"modified\" | \"removed\"). Null clears it."
                  },
                  {
                    "name": "source",
                    "type": "string | null",
                    "required": false,
                    "description": "Source location \"path:line\". Null clears it."
                  }
                ]
              }
            ],
            "returns": "Props patch { frames }, revalidated against CallStackState",
            "kind": "action"
          },
          {
            "name": "call-stack.removeRow",
            "description": "Remove the frame row at an index path, together with its nested `frames`.",
            "params": [
              {
                "name": "path",
                "type": "integer[]",
                "required": true,
                "description": "Index path of the frame to remove, e.g. [0, 2]."
              }
            ],
            "returns": "Props patch { frames }, revalidated against CallStackState",
            "kind": "action"
          },
          {
            "name": "call-stack.moveRow",
            "description": "Move the frame row at `from` (with its nested `frames`) to the insert position `to`. `to` is interpreted against the tree AFTER the row is removed.",
            "params": [
              {
                "name": "from",
                "type": "integer[]",
                "required": true,
                "description": "Index path of the frame to move."
              },
              {
                "name": "to",
                "type": "integer[]",
                "required": true,
                "description": "Insertion index path (last element = insert position), resolved after the row is detached."
              }
            ],
            "returns": "Props patch { frames }, revalidated against CallStackState",
            "kind": "action"
          },
          {
            "name": "call-stack.setRows",
            "description": "Bulk replace: swap the entire frame tree for the given rows.",
            "params": [
              {
                "name": "rows",
                "type": "CallStackRow[]",
                "required": true,
                "description": "Complete replacement frame tree (nested via `frames`). An empty array empties the block."
              }
            ],
            "returns": "Props patch { frames }, revalidated against CallStackState",
            "kind": "action"
          }
        ]
      },
      "children": []
    },
