    "cs-h-rules": {
      "id": "cs-h-rules",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Writing the Frames"
        }
      ],
      "children": []
    },
    "cs-rules-lead": {
      "id": "cs-rules-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Each frame stands for one line of the source, so the reader can find that line and trust the tree. The rules below keep the tree and its two side columns true to the code."
        }
      ],
      "children": []
    },
    "cs-rules-g1": {
      "id": "cs-rules-g1",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "The tree copies the code",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "cs-rules-g1-5",
        "cs-rules-g1-1",
        "cs-rules-g1-4",
        "cs-rules-g1-6",
        "cs-rules-g1-3"
      ]
    },
    "cs-rules-g1-5": {
      "id": "cs-rules-g1-5",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "The stack starts at the entry frame the reader searches for and stops at the frame where the reader's task ends. A stack on a short page holds at most 20 frames, and logging, timing, and bookkeeping calls stay out."
        }
      ],
      "children": []
    },
    "cs-rules-g1-1": {
      "id": "cs-rules-g1-1",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A frame's children are the calls that its own body makes, in source order."
        }
      ],
      "children": []
    },
    "cs-rules-g1-4": {
      "id": "cs-rules-g1-4",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A call inside another call's arguments runs first, in the same caller, so it is an earlier sibling and never a child."
        }
      ],
      "children": []
    },
    "cs-rules-g1-6": {
      "id": "cs-rules-g1-6",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A callback that calls a named function shows that function as its own frame. Under "
        },
        {
          "insert": "judgeSlot(() => tier2(page))",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", the frames of "
        },
        {
          "insert": "tier2",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "'s body nest under a "
        },
        {
          "insert": "tier2(page)",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " frame, not under "
        },
        {
          "insert": "judgeSlot",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "cs-rules-g1-3": {
      "id": "cs-rules-g1-3",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A frame's text is the call as the source writes it, with only arguments shortened to "
        },
        {
          "insert": "…",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Two calls or two checks never share one frame."
        }
      ],
      "children": []
    },
    "cs-rules-g3": {
      "id": "cs-rules-g3",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Control flow shows as branch frames",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "cs-rules-g1-2",
        "cs-rules-g3-2",
        "cs-rules-g3-3",
        "cs-rules-g3-4",
        "cs-rules-g3-5"
      ]
    },
    "cs-rules-g1-2": {
      "id": "cs-rules-g1-2",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Each guard on the path that returns or throws is a "
        },
        {
          "insert": "branch",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " frame with the condition as the source writes it. The "
        },
        {
          "insert": "return",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " or "
        },
        {
          "insert": "throw",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " nests under it, and the frames after the guard stay outside it."
        }
      ],
      "children": []
    },
    "cs-rules-g3-2": {
      "id": "cs-rules-g3-2",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A loop, a "
        },
        {
          "insert": "try",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " block, and a "
        },
        {
          "insert": "catch",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " block are "
        },
        {
          "insert": "branch",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " frames too, such as "
        },
        {
          "insert": "for (const block of blocks)",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " or "
        },
        {
          "insert": "catch (error)",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The calls of their body nest under that frame as frames, never only in its comment."
        }
      ],
      "children": []
    },
    "cs-rules-g3-3": {
      "id": "cs-rules-g3-3",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A branch frame always holds the frames that its condition gates. For the "
        },
        {
          "insert": "else",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " arm of an "
        },
        {
          "insert": "if",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " or a ternary, write the negated condition, such as "
        },
        {
          "insert": "baseline !== undefined",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for "
        },
        {
          "insert": "baseline === undefined ? undefined : styleGate(…)",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "cs-rules-g3-4": {
      "id": "cs-rules-g3-4",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A branch frame tests a condition that the source tests. One call with a conditional argument, such as "
        },
        {
          "insert": "writeFile(failed ? failedPath : path, …)",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", stays one frame and never becomes two branches."
        }
      ],
      "children": []
    },
    "cs-rules-g3-5": {
      "id": "cs-rules-g3-5",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A guard or a "
        },
        {
          "insert": "catch",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " block is in the stack only when the reader's task can reach it and needs it. Generic error handling around the path, such as argument validation and reply wrapping, stays out, and the text before the block names what it leaves out."
        }
      ],
      "children": []
    },
    "cs-rules-g2": {
      "id": "cs-rules-g2",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "The columns point and explain",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "cs-rules-g2-1",
        "cs-rules-g2-2",
        "cs-rules-g2-4",
        "cs-rules-g2-3",
        "cs-rules-g2-6",
        "cs-rules-g2-5"
      ]
    },
    "cs-rules-g2-1": {
      "id": "cs-rules-g2-1",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A "
        },
        {
          "insert": "source",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the line where the caller writes the call or the condition, not the line where the callee starts. Only the top frame cites the line where its own handler starts."
        }
      ],
      "children": []
    },
    "cs-rules-g2-2": {
      "id": "cs-rules-g2-2",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A "
        },
        {
          "insert": "return",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " row has no "
        },
        {
          "insert": "source",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", but a "
        },
        {
          "insert": "throw",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " row cites the line of its "
        },
        {
          "insert": "throw",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "cs-rules-g2-4": {
      "id": "cs-rules-g2-4",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A frame for code that does not exist yet has "
        },
        {
          "insert": "change: \"added\"",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", no "
        },
        {
          "insert": "source",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and a comment that says the frame is proposed."
        }
      ],
      "children": []
    },
    "cs-rules-g2-3": {
      "id": "cs-rules-g2-3",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A comment adds one fact the row does not show, such as what the frame refuses, returns, locks, or writes. A comment that only repeats the row or the function name is left out."
        }
      ],
      "children": []
    },
    "cs-rules-g2-6": {
      "id": "cs-rules-g2-6",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A comment says only what this frame's own body does, and a step that runs only sometimes keeps its condition, as in \"up to one judge call\"."
        }
      ],
      "children": []
    },
    "cs-rules-g2-5": {
      "id": "cs-rules-g2-5",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Code inside a comment goes between backticks, such as "
        },
        {
          "insert": "`!judgeUp`",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and renders in the code font. Plain words, such as a finding's message, stay outside backticks."
        }
      ],
      "children": []
    },
