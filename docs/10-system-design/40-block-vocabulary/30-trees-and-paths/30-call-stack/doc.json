    "cs-intro": {
      "id": "cs-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The call-stack component owns one block type, "
        },
        {
          "insert": "call-stack",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", a tree of the calls on one code path. Each frame is one code row with its file and line. A "
        },
        {
          "insert": "branch",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " frame marks a condition, and "
        },
        {
          "insert": "change",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " marks a frame a diff added, modified, or removed. Use process outline for prose steps and component tree for a render tree."
        }
      ],
      "children": []
    },
