    "cs-example-lead": {
      "id": "cs-example-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "This call stack follows one "
        },
        {
          "insert": "docs_apply_ops",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " request from the MCP tool down to the file write. The branch frame is the stale-hash check, and its child is the early return."
        }
      ],
      "children": []
    },
    "cs-example": {
      "id": "cs-example",
      "type": "call-stack",
      "props": {
        "frames": [
          {
            "text": "docs_apply_ops({ path, expected_hash, ops })",
            "comment": "MCP tool, one atomic op batch",
            "source": "packages/docs-mcp/src/tools.ts:383",
            "frames": [
              {
                "text": "apply(store, args, args.ops, ctx)",
                "comment": "refuses sidecar actions in a batch",
                "source": "packages/docs-mcp/src/tools.ts:223",
                "frames": [
                  {
                    "text": "priorDoc(store, args.path)",
                    "comment": "document before the write",
                    "source": "packages/docs-mcp/src/tools.ts:186"
                  },
                  {
                    "text": "store.applyDocOps(path, ops, expected_hash)",
                    "source": "packages/docs-server/src/store.ts:584",
                    "frames": [
                      {
                        "text": "applyDocOpsToBundle(root, path, ops, …)",
                        "comment": "runs inside withPathLock",
                        "source": "packages/docs-server/src/doc-ops.ts:67",
                        "frames": [
                          {
                            "text": "loadDocBundle(docsRoot, path)",
                            "comment": "current document and docHash",
                            "source": "packages/docs-server/src/bundle.ts:65"
                          },
                          {
                            "text": "expectedHash !== loaded.docHash",
                            "kind": "branch",
                            "source": "packages/docs-server/src/doc-ops.ts:85",
                            "frames": [
                              {
                                "text": "return { status: 409, … }",
                                "comment": "stale bundle, reload first"
                              }
                            ]
                          },
                          {
                            "text": "applyOps(loaded.document, ops, …)",
                            "comment": "pure, collects the inverse ops",
                            "source": "packages/docs-server/src/doc-ops.ts:108"
                          },
                          {
                            "text": "validateDocDocument(result.doc)",
                            "comment": "whole document again, else 422",
                            "source": "packages/docs-server/src/doc-ops.ts:123"
                          },
                          {
                            "text": "atomicWriteFile(loaded.jsonAbs, serialized)",
                            "comment": "canonical bytes, new hash",
                            "source": "packages/docs-server/src/doc-ops.ts:158"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "text": "applied(store, path, result, write)",
                    "comment": "style findings first, then the new hash",
                    "source": "packages/docs-mcp/src/tools.ts:197"
                  }
                ]
              }
            ]
          }
        ]
      },
      "children": []
