    "ps-act-surface": {
      "id": "ps-act-surface",
      "type": "interaction-surface",
      "props": {
        "operations": [
          {
            "name": "pseudocode.insertLine",
            "kind": "action",
            "description": "Insert one pseudocode line at a 0-based index. An index equal to the line count appends.",
            "params": [
              {
                "name": "index",
                "type": "integer",
                "required": true,
                "description": "Insert position in [0, line count]."
              },
              {
                "name": "text",
                "type": "string",
                "required": true,
                "description": "Line text without a diff marker or newlines. Leading spaces indent."
              },
              {
                "name": "marker",
                "type": "\"+\" | \"-\" | \" \"",
                "required": false,
                "description": "Diff marker for diff blocks only. Defaults to a space."
              }
            ],
            "returns": "Replacement block text"
          },
          {
            "name": "pseudocode.updateLine",
            "kind": "action",
            "description": "Replace the text, the diff marker, or both on the line at a 0-based index.",
            "params": [
              {
                "name": "index",
                "type": "integer",
                "required": true,
                "description": "Line index in [0, line count - 1]."
              },
              {
                "name": "text",
                "type": "string",
                "required": false,
                "description": "New line text without a diff marker or newlines."
              },
              {
                "name": "marker",
                "type": "\"+\" | \"-\" | \" \" | null",
                "required": false,
                "description": "New diff marker for diff blocks only. Null resets it to a space, an unchanged line."
              }
            ],
            "returns": "Replacement block text"
          },
          {
            "name": "pseudocode.removeLine",
            "kind": "action",
            "description": "Remove the pseudocode line at a 0-based index.",
            "params": [
              {
                "name": "index",
                "type": "integer",
                "required": true,
                "description": "Line index in [0, line count - 1]."
              }
            ],
            "returns": "Replacement block text"
          },
          {
            "name": "pseudocode.setLines",
            "kind": "action",
            "description": "Bulk replace: swap every pseudocode line, optionally turning the diff gutter on or off.",
            "params": [
              {
                "name": "lines",
                "type": "{ text, marker? }[]",
                "required": true,
                "description": "Complete replacement lines in order. An empty array clears the pseudocode."
              },
              {
                "name": "diff",
                "type": "boolean",
                "required": false,
                "description": "Set the diff gutter on or off in the same edit. Omit to keep it."
              }
            ],
            "returns": "Replacement block text, plus the props patch { diff } when diff is passed"
          }
        ]
      },
