      "children": []
    },
    "pseudo-write-steps-3": {
      "id": "pseudo-write-steps-3",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Say a fallback for a missing value in words, such as \"the usage of the result, or 0 when the result has no usage\", not "
        },
        {
          "insert": "result?.usage ?? 0",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Leave out a fallback that only satisfies the type checker, such as a default start for a regex match that always has one."
        }
      ],
      "children": []
    },
    "pseudo-write-steps-4": {
      "id": "pseudo-write-steps-4",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Name the list, map, or field that a step changes, such as \"append the code span to spans\". Describe an object, an index such as "
        },
        {
          "insert": "match[1]",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", a regex, or a range in words, such as \"the text from cursor up to index, not including index\"."
        }
      ],
      "children": []
    },
    "pseudo-write-steps-5": {
      "id": "pseudo-write-steps-5",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Show a try and its catch as two steps, such as \"try to parse the line as JSON\" and \"if the parse fails -> skip the line\"."
        }
      ],
      "children": []
    },
