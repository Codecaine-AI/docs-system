    "pseudo-intro": {
      "id": "pseudo-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The pseudocode component owns one block type, "
        },
        {
          "insert": "pseudocode",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", a plain-language code listing that explains an algorithm or a change in logic without real syntax. The viewer highlights control words, calls, and "
        },
        {
          "insert": "->",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " arrows, and it moves each trailing "
        },
        {
          "insert": "//",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " comment into one aligned column. When the reader needs the actual source, use the code block."
        }
      ],
      "children": []
    },
    "pseudo-h-write": {
      "id": "pseudo-h-write",
      "type": "heading",
      "props": {
        "level": 2
