    "pseudo-write-names-0": {
      "id": "pseudo-write-names-0",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Open each block with the header line of its function at indent 0, such as "
        },
        {
          "insert": "parseTranscript(jsonl)",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and give each function its own block. The viewer sets the header line in a heavier weight."
        }
      ],
      "children": []
    },
    "pseudo-write-names-1": {
      "id": "pseudo-write-names-1",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Name a loop variable so its line reads as English, such as \"for each candidate after the verb\", not \"for each word after word\"."
        }
      ],
      "children": []
    },
    "pseudo-write-names-2": {
      "id": "pseudo-write-names-2",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Start a control step with its control word, such as \"skip the candidate\" or \"return path\", so the viewer colors it. Say what a stop ends, such as \"leave the loop\", never a bare \"stop\"."
        }
      ],
      "children": []
    },
    "pseudo-write-names-3": {
      "id": "pseudo-write-names-3",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Repeat the noun in place of \"it\" or \"them\", such as \"or 0 when the match has no start\". Name both ends of \"between\", such as \"between the verb and the condition word\"."
        }
      ],
      "children": []
    },
    "pseudo-write-names-4": {
      "id": "pseudo-write-names-4",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Keep a line to about 70 characters, so it does not wrap. Split a long condition into a named step, such as \"quoted = the word is inside quotes\"."
        }
      ],
      "children": []
    },
    "pseudo-write-comments": {
