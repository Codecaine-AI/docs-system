    "pseudo-write-steps-1": {
      "id": "pseudo-write-steps-1",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Keep the source's branches, loops, calls, and returns in order, with every condition each one tests, such as a check that ignores quoted words."
        }
      ],
      "children": []
    },
