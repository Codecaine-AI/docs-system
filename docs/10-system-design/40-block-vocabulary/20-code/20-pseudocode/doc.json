    "pseudo-write-lead": {
      "id": "pseudo-write-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A pseudocode block restates one function or algorithm as plain steps, one step per line with 2 spaces of indent for each level of nesting. A reader can follow it without knowing the source language. The "
        },
        {
          "insert": "pseudocode.code-syntax",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " lint flags the operators that the first group bans."
        }
      ],
      "children": []
    },
    "pseudo-write-steps": {
      "id": "pseudo-write-steps",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Write each step in plain words",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "pseudo-write-steps-1",
        "pseudo-write-steps-2",
