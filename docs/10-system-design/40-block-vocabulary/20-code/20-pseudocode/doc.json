          "insert": " to compare two values, "
        },
        {
          "insert": "is",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for a state such as "
        },
        {
          "insert": "is empty",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "and",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "or",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "add 1 to",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in place of "
        },
        {
          "insert": "===",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "&&",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "||",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "+=",
          "attributes": {
