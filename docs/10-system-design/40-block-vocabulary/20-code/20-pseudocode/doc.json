    "ps-act-surface": {
      "id": "ps-act-surface",
      "type": "interaction-surface",
      "props": {
        "operations": [
          {
            "name": "pseudocode.insertLine",
            "kind": "action",
            "description": "Insert one pseudocode line at a 0-based index. An index equal to the line count appends.",
            "params": [
              {
                "name": "index",
                "type": "integer",
                "required": true,
                "description": "Insert position in [0, line count]."
              },
              {
                "name": "text",
                "type": "string",
                "required": true,
                "description": "Line text without a diff marker or newlines. Leading spaces indent."
              },
              {
                "name": "marker",
                "type": "\"+\" | \"-\" | \" \"",
                "required": false,
                "description": "Diff marker for diff blocks only. Defaults to a space."
