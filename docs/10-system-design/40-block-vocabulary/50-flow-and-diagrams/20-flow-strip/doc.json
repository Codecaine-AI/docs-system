    "fs-intro": {
      "id": "fs-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The flow strip component owns one block type, "
        },
        {
          "insert": "flow-strip",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", a row of numbered step cards joined by arrows. It shows a short linear loop or pipeline of three to six steps at a glance. Use process outline when steps nest or need notes, and sequence when the messages between parties matter."
        }
      ],
      "children": []
    },
