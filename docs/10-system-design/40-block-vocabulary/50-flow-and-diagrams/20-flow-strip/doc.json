    "fs-example-lead": {
      "id": "fs-example-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "This strip is the edit loop that "
        },
        {
          "insert": "packages/docs-mcp/src/service.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "packages/docs-mcp/src/tools.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " enforce for every page edit."
        }
      ],
      "children": []
    },
    "fs-example": {
      "id": "fs-example",
      "type": "flow-strip",
      "props": {
        "caption": "When `docs_check` fails, fix the findings in its `style_gate` and check again.",
        "steps": [
          {
            "name": "docs_discover",
            "detail": "Lists the workspace's projects."
          },
          {
            "name": "docs_begin",
            "detail": "Pins the guidance snapshot and returns `task_id`."
          },
          {
            "name": "docs_guidance",
            "detail": "Reads topic `style` once per task. Writes are refused until then."
          },
          {
            "name": "docs_apply_ops",
            "detail": "Applies typed ops atomically against `expected_hash`."
          },
          {
            "name": "docs_check",
            "detail": "Fails on style violations this task introduced."
          },
          {
            "name": "docs_end",
            "detail": "Releases the snapshot. Edits stay saved."
          }
        ],
        "title": "Docs MCP edit loop"
      },
      "children": []
    },
