    "st-act-surface": {
      "id": "st-act-surface",
      "type": "interaction-surface",
      "props": {
        "operations": [
          {
            "name": "stack.addNode",
            "kind": "action",
            "description": "Insert a node with any children at the top level or under the named parent. Index defaults to the end. Names must stay unique across the stack.",
            "params": [
              {
                "name": "node",
                "type": "StackNode",
                "required": true
              },
              {
                "name": "parent",
                "type": "string",
                "required": false,
                "description": "Name of the parent node. Omit to insert at the top level."
              },
              {
                "name": "index",
                "type": "integer",
                "required": false,
                "description": "Insert position among the parent's children. Default end."
              }
            ],
            "returns": "Props patch with the changed nodes, boundaries, or both"
          },
          {
            "name": "stack.updateNode",
            "kind": "action",
            "description": "Patch the named node's own fields and leave its children alone. patch.name renames it and repoints any boundary after it.",
            "params": [
              {
                "name": "name",
                "type": "string",
                "required": true,
                "description": "Name of the node to patch."
              },
              {
                "name": "patch",
                "type": "object",
                "required": true,
                "description": "Partial node. Null clears detail, badge, color, uses, or columns.",
                "fields": [
                  {
                    "name": "name",
                    "type": "string",
                    "required": false,
                    "description": "New name. Must stay unique."
                  },
                  {
                    "name": "detail",
                    "type": "string | null",
                    "required": false,
                    "description": "One line under the name. Null clears."
                  },
                  {
                    "name": "badge",
                    "type": "string | null",
                    "required": false,
                    "description": "Short tag beside the name. Null clears."
                  },
                  {
                    "name": "color",
                    "type": "\"gray\" | \"blue\" | \"green\" | \"orange\" | \"yellow\" | \"red\" | \"purple\" | \"pink\" | null",
                    "required": false,
                    "description": "Container tint or leaf badge color. Null clears."
                  },
                  {
                    "name": "uses",
                    "type": "true | string | null",
                    "required": false,
                    "description": "true draws an unlabeled arrow to the next sibling, a string labels it, null removes it."
                  },
                  {
                    "name": "columns",
                    "type": "2 | null",
                    "required": false,
                    "description": "2 lays children in two columns. Null clears."
                  }
                ]
              }
            ],
            "returns": "Props patch with the changed nodes, boundaries, or both"
          },
          {
            "name": "stack.removeNode",
            "kind": "action",
            "description": "Remove the named node with its whole subtree, and every boundary that follows a removed node.",
            "params": [
              {
                "name": "name",
                "type": "string",
                "required": true,
                "description": "Name of the node to remove."
              }
            ],
            "returns": "Props patch with the changed nodes, boundaries, or both"
          },
          {
            "name": "stack.moveNode",
            "kind": "action",
            "description": "Move the named node with its subtree under another parent or to the top level, at an index resolved after the node is detached. Boundaries move with it.",
            "params": [
              {
                "name": "name",
                "type": "string",
                "required": true,
                "description": "Name of the node to move."
              },
              {
                "name": "parent",
                "type": "string | null",
                "required": false,
                "description": "New parent's name. Null moves to the top level. Omit to stay under the current parent."
              },
              {
                "name": "index",
                "type": "integer",
                "required": false,
                "description": "Insert position among the destination's children after detaching. Default end."
              }
            ],
            "returns": "Props patch with the changed nodes, boundaries, or both"
          },
          {
            "name": "stack.setBoundary",
            "kind": "action",
            "description": "Draw or replace the dashed boundary line beneath the named node, labeled with the rule enforced there. Upserts by `after`.",
            "params": [
              {
                "name": "after",
                "type": "string",
                "required": true,
                "description": "Name of the node the line sits beneath."
              },
              {
                "name": "rule",
                "type": "string",
                "required": true,
                "description": "The rule enforced at this line."
              }
            ],
            "returns": "Props patch with the changed nodes, boundaries, or both"
          },
          {
            "name": "stack.removeBoundary",
            "kind": "action",
            "description": "Remove the boundary line beneath the named node.",
            "params": [
              {
                "name": "after",
                "type": "string",
                "required": true,
                "description": "Name of the node whose boundary line to remove."
              }
            ],
            "returns": "Props patch with the changed nodes, boundaries, or both"
          }
        ]
      },
      "children": []
