      "children": []
    },
    "bw-rule-4b": {
      "id": "bw-rule-4b",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Every field ledger uses one 24ch name column and a 24px gap, so type columns line up across blocks."
        }
      ],
      "children": []
    },
    "bw-rule-4c": {
      "id": "bw-rule-4c",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A long name wraps inside its column, also at "
        },
        {
          "insert": "_",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". A type always starts on the name's first line and wraps inside the type column."
        }
      ],
      "children": []
    },
    "bw-rule-5": {
      "id": "bw-rule-5",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Two-pane blocks split only when there is room",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "bw-rule-5a"
      ]
    },
    "bw-rule-5a": {
      "id": "bw-rule-5a",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "The state shape and the interaction surface split the list and the code 44/56 when the block is at least 560px wide. The list keeps at least 360px and the code pane at least 260px, and a narrower block stacks the two panes."
        }
      ],
      "children": []
    },
