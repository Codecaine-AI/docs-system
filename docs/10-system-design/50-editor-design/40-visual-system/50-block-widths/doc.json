    "bw-table-3": {
      "id": "bw-table-3",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "The text column with the longest average text takes the remaining width and wraps at 60ch."
        }
      ],
      "children": []
    },
    "bw-table-4": {
      "id": "bw-table-4",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "If the table still overflows its lane, the first column stays pinned and the other columns scroll under it."
        }
      ],
      "children": []
    },
