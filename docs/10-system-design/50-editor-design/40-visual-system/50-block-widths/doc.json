    },
    "bw-why-lead": {
      "id": "bw-why-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Four reasons shape the lanes:"
        }
      ],
      "children": []
    },
    "bw-why-1": {
      "id": "bw-why-1",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "The eye keeps one left rail",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "bw-why-1a"
      ]
    },
    "bw-why-1a": {
      "id": "bw-why-1a",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Every lane starts at the page's left edge, so you read straight down one column of block starts."
        }
      ],
      "children": []
    },
    "bw-why-2": {
      "id": "bw-why-2",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Wide blocks spend room only when content needs it",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "bw-why-2a"
      ]
    },
    "bw-why-2a": {
      "id": "bw-why-2a",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A short table stays narrow, and a dense state shape grows to 1100px without widening the prose around it."
        }
      ],
      "children": []
    },
    "bw-why-3": {
      "id": "bw-why-3",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Prose keeps a readable line length",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "bw-why-3a"
      ]
    },
    "bw-why-3a": {
      "id": "bw-why-3a",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A line of 60 characters or less is easier to track back to its start than a line that spans the page."
        }
      ],
      "children": []
    },
    "bw-why-4": {
      "id": "bw-why-4",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Values stay copyable",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "bw-why-4a"
      ]
    },
    "bw-why-4a": {
      "id": "bw-why-4a",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A path or a type that never breaks mid-word copies and searches as one string."
        }
      ],
      "children": []
    }
