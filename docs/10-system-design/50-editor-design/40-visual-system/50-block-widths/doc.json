    "bw-intro": {
      "id": "bw-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Every block sits in one of three lanes that start on the page's left rail. A block type declares its lane on its registry descriptor, and the lane caps how wide the block may grow. Inside its lane a block shrinks to its content, so a short file tree stays narrow while a dense state shape spends the room it needs."
        }
      ],
      "children": []
    },
    "bw-h-rule": {
      "id": "bw-h-rule",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "The Rule"
        }
      ],
      "children": []
    },
    "bw-rule-lead": {
      "id": "bw-rule-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Five rules decide how wide a block is:"
        }
      ],
      "children": []
    },
    "bw-rule-1": {
      "id": "bw-rule-1",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Each block type declares one lane",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "bw-rule-1a",
        "bw-rule-1b"
      ]
    },
    "bw-rule-1a": {
      "id": "bw-rule-1a",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "The "
        },
        {
          "insert": "layout",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " field on the descriptor names the lane, and "
        },
        {
          "insert": "docBlockLayoutClasses",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in "
        },
        {
          "insert": "packages/docs-viewer/src/render/block-layout.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " turns it into the lane's width cap."
        }
      ],
      "children": []
    },
    "bw-rule-1b": {
      "id": "bw-rule-1b",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A descriptor without "
        },
        {
          "insert": "layout",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " gets the text lane."
        }
      ],
      "children": []
    },
    "bw-rule-2": {
      "id": "bw-rule-2",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A lane is a maximum, never a target",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "bw-rule-2a",
        "bw-rule-2b",
        "bw-rule-2c"
      ]
    },
    "bw-rule-2a": {
      "id": "bw-rule-2a",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "The file tree, file explorer, call stack, component tree, process outline, stack, and structured table shrink to their content."
        }
      ],
      "children": []
    },
    "bw-rule-2b": {
      "id": "bw-rule-2b",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "The state shape, interaction surface, canvas, sequence, and code block fill their lane because their panes need the room."
        }
      ],
      "children": []
    },
    "bw-rule-2c": {
      "id": "bw-rule-2c",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "The file explorer never shrinks below the widest width it has reached, so folding a folder does not make it jump."
        }
      ],
      "children": []
    },
    "bw-rule-3": {
      "id": "bw-rule-3",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Prose wraps at 60ch or less",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "bw-rule-3a"
      ]
    },
    "bw-rule-3a": {
      "id": "bw-rule-3a",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Descriptions, notes, comments, tooltips, and captions keep the reading measure inside every block."
        }
      ],
      "children": []
    },
    "bw-rule-4": {
      "id": "bw-rule-4",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Mono values never break mid-word",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "bw-rule-4a",
        "bw-rule-4b",
        "bw-rule-4c"
      ]
    },
