    "tm-intro": {
      "id": "tm-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Text measurement predicts how wide text paints and where it wraps, without rendering a page. The docs layout lints and the sequence layout measure through one package, "
        },
        {
          "insert": "@codecaine-ai/text-measure",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", so a label that a lint says fits also fits on screen. The answers are exact only when the three conditions in The Rule hold."
        }
      ],
      "children": []
    },
    "tm-h-structure": {
      "id": "tm-h-structure",
      "type": "heading",
