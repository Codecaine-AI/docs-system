      ],
      "children": []
    },
    "tm-structure-lead": {
      "id": "tm-structure-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Pretext 0.0.9 breaks the lines, and the active backend supplies every width. "
        },
        {
          "insert": "measureWidth",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "wrapText",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "fitText",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " answer one-line widths, wrapped lines, and fit verdicts. The package bundles Inter 3.19 at weights 400, 500, 600, and 700 and IBM Plex Mono 2.5 at 400, 500, and 600. Each face ships as a woff2 file for browsers and a TTF file for headless hosts. The package lives at "
        },
        {
          "insert": "canvas/packages/text-measure",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in the core workspace, and its "
        },
        {
          "insert": "README.md",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " documents the full API."
        }
      ],
      "children": []
    },
