    "b-typo-role-rule": {
      "id": "b-typo-role-rule",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A font follows its reading role across every surface. Components do not choose local font families."
        }
      ],
      "children": []
    },
