    "b-typo-book-measure": {
      "id": "b-typo-book-measure",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Inter's "
        },
        {
          "insert": "0",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is 0.625em wide, so "
        },
        {
          "insert": "1ch",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " at 18px is 11.25px and a "
        },
        {
          "insert": "60ch",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " lane is 675px. On this corpus's prose Inter averages about 8.5px per character at 18px, so the lane holds about 79 characters, close to the book's line of about 80. The lane is set in "
        },
        {
          "insert": "ch",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", so its width scales with the font size and the character count stays the same. A different body face changes the lane width. For example, SF Pro on macOS has a "
        },
        {
          "insert": "0",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " of about 10.84px, which makes the lane about 650px. The content width control ranges from "
        },
        {
          "insert": "40ch",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " to "
        },
        {
          "insert": "140ch",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
