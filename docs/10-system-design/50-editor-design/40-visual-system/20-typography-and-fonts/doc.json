    "b-typo-intro": {
      "id": "b-typo-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Typography assigns font families by reading role: body, heading, code, and numeric. Shared reading metrics set the size, line height, and tracking for the document column. The structural decisions behind theme loading and variable injection live in "
        },
        {
          "insert": "Theming: Overview",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "20-implementation/40-theming"
            }
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
