    "b-typo-intro": {
      "id": "b-typo-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Typography assigns font families by reading role: body, heading, code, and numeric. The Default theme sets body and headings in Inter and code in IBM Plex Mono, the two families the workbench bundles. Shared reading metrics set the size, line height, and tracking for the document column, and the shared Global theme from "
        },
        {
          "insert": "Themes",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/50-editor-design/40-visual-system/30-themes"
            }
          }
        },
        {
          "insert": " starts from these stock values. The structural decisions behind theme loading and variable injection live in "
        },
        {
          "insert": "Theming: Overview",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "30-implementation/40-theming"
            }
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
