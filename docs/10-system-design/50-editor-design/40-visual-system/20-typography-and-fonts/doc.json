    "b-typo-why-seams": {
      "id": "b-typo-why-seams",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Reading roles are explicit seams",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "b-typo-why-seams-gloss"
      ]
    },
    "b-typo-why-seams-gloss": {
      "id": "b-typo-why-seams-gloss",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A theme can separate code or numerals without changing prose, headings, or individual components."
        }
      ],
      "children": []
    },
    "b-typo-why-book": {
      "id": "b-typo-why-book",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Metrics follow a book that reads well",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "b-typo-why-book-gloss"
      ]
    },
    "b-typo-why-book-gloss": {
      "id": "b-typo-why-book-gloss",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "The stock defaults adapt a printed layout the owner reads comfortably for long sessions, and the Global theme every project renders starts from them. The 18px size at a 1.45 line height keeps the book's 26px line pitch. The measure is set in "
        },
        {
          "insert": "ch",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", so the line keeps about 84 characters when the font size changes."
        }
      ],
      "children": []
    }
  }
