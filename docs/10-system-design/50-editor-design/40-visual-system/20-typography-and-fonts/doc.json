    "b-typo-stack-rule": {
      "id": "b-typo-stack-rule",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Body and headings default to System Sans, which resolves to "
        },
        {
          "insert": "ui-sans-serif, system-ui, sans-serif",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and is SF Pro on macOS. The System Serif option resolves to "
        },
        {
          "insert": "ui-serif, Georgia, \"Times New Roman\", serif",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", which is New York on macOS. Mono resolves to "
        },
        {
          "insert": "ui-monospace, \"SF Mono\", SFMono-Regular, Menlo, monospace",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Numeric emits no separate family while it follows body."
        }
      ],
      "children": []
    },
    "b-typo-file-status": {
      "id": "b-typo-file-status",
      "type": "callout",
      "props": {
        "kind": "Boundary",
        "title": "Fonts resolve from the host",
        "tone": "info"
      },
      "text": [
        {
          "insert": "A theme names font families. A stack resolves only when the browser or host already provides the face. The workbench loads no repository font binaries and registers no "
        },
        {
          "insert": "@font-face",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rules."
        }
      ],
      "children": []
