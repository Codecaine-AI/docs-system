        "tone": "info"
      },
      "text": [
        {
          "insert": "Repository "
        },
        {
          "insert": "themes/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " folders, including "
        },
        {
          "insert": "themes/default/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", stay on disk, but no project loads them while the Global theme is active. The owner chose the Global theme as the default for now."
        }
      ],
      "children": []
    },
    "b-them-default-heading": {
      "id": "b-them-default-heading",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "The Living Default"
        }
      ],
      "children": []
    },
    "b-them-default-living": {
      "id": "b-them-default-living",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Default is the repository's living theme on a host that serves no Global theme. Every rail setting, dark toggle, and component override auto-saves into it shortly after the last change. Selecting Default restores the saved look."
        }
      ],
      "children": []
    },
    "b-them-default-storage": {
      "id": "b-them-default-storage",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "The saved state is complete: every scalar setting carries a saved value, so Default restores the whole look rather than a diff; component values are saved only where they diverge."
        }
      ],
      "children": []
    },
    "b-them-default-overlay": {
      "id": "b-them-default-overlay",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Active rail overrides still win over the saved values."
        }
      ],
      "children": []
    },
    "b-them-default-authority": {
      "id": "b-them-default-authority",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "The repository copy is the durable authority. Browser-local state is a cache and a fallback, and never overrides settings loaded from the repository."
        }
      ],
      "children": []
    },
    "b-them-default-hydrate": {
      "id": "b-them-default-hydrate",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A fresh browser profile hydrates from the repository Default before autosave engages."
        }
      ],
      "children": []
    },
    "b-them-default-locked": {
      "id": "b-them-default-locked",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A theme-locked serve applies the Global theme unconditionally, or the repository Default when it serves no Global theme. It hides the rail and rejects theme writes. A static export is read-only."
        }
      ],
      "children": []
    },
    "b-them-boundary-heading": {
      "id": "b-them-boundary-heading",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "The Customization Boundary"
        }
      ],
      "children": []
    },
    "b-them-boundary-contract": {
      "id": "b-them-boundary-contract",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Registered colors, typography, global radius, document layout values, and component tokens may follow a theme. System UI structure stays fixed. Unregistered widths, row geometry, visibility breakpoints, and interaction framing do not become theme values. The fixed structure keeps every theme recognizable as the same tool."
        }
      ],
      "children": []
    },
    "b-them-why-heading": {
      "id": "b-them-why-heading",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Why"
        }
      ],
      "children": []
    },
    "b-them-why-safe": {
      "id": "b-them-why-safe",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Hand editing fails safely",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "b-them-why-safe-gloss"
      ]
    },
    "b-them-why-safe-gloss": {
      "id": "b-them-why-safe-gloss",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A typo or unsupported key cannot escape the closed vocabulary and change an arbitrary application property."
        }
      ],
      "children": []
    },
    "b-them-why-visual": {
      "id": "b-them-why-visual",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Default is adjustable by eye",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "b-them-why-visual-gloss"
      ]
    },
    "b-them-why-visual-gloss": {
      "id": "b-them-why-visual-gloss",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Visual feedback and automatic persistence make the repo's core look quick to tune without a manual export step."
        }
      ],
      "children": []
    },
    "b-them-why-identity": {
      "id": "b-them-why-identity",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Customization is bounded",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "b-them-why-identity-gloss"
      ]
    },
    "b-them-why-identity-gloss": {
      "id": "b-them-why-identity-gloss",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A theme can make the document its own without turning the surrounding workbench into a different product."
        }
      ],
      "children": []
    },
    "b-them-why-global": {
      "id": "b-them-why-global",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "One reading look across projects",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "b-them-why-global-gloss"
      ]
    },
    "b-them-why-global-gloss": {
      "id": "b-them-why-global-gloss",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "The owner wants one reading look across all projects. Per-repository themes drifted apart, and a change tuned in one project stayed hidden from the others."
        }
      ],
      "children": []
    }
  }
