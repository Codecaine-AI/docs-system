    "b-them-res-chain": {
      "id": "b-them-res-chain",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A theme resolves over a base chain. The folder's values apply over its named built-in base, and an unknown base ends the chain rather than failing the theme."
        }
      ],
      "children": []
    },
    "b-them-res-shadow": {
      "id": "b-them-res-shadow",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A repository theme shadows a built-in theme with the same id."
        }
      ],
      "children": []
    },
    "b-them-res-reserved": {
      "id": "b-them-res-reserved",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "The id "
        },
        {
          "insert": "global",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is reserved. A repository folder named "
        },
        {
          "insert": "global",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is ignored, so it never shadows the Global theme."
        }
      ],
      "children": []
    },
    "b-them-res-modes": {
      "id": "b-them-res-modes",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Every theme resolves to a light and a dark value set. A single scalar value applies to both modes."
        }
      ],
      "children": []
    },
    "b-them-res-select": {
      "id": "b-them-res-select",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Selecting a theme applies its declared mode, adopts its rail defaults as the working settings, and persists as the active selection across sessions."
        }
      ],
      "children": []
    },
    "b-them-res-transfer": {
      "id": "b-them-res-transfer",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Theme settings also travel as an exported file. Import validates and normalizes the payload, and an invalid file leaves the active state unchanged."
        }
      ],
      "children": []
    },
    "b-them-authority-table": {
