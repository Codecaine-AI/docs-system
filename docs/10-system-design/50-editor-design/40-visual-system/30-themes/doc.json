        ],
        "rows": [
          [
            "Rail settings and component values",
            "Shared through the Global theme"
          ],
          [
            "Light or dark mode",
            "Shared through the Global theme"
          ],
          [
            "Rail collapse",
            "Per project"
          ],
          [
            "Selected rail section",
            "Per project"
          ]
        ]
