    "b-them-intro": {
      "id": "b-them-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A theme may change registered document-surface roles while fixed system UI structure preserves the tool's identity. Theme folders are sparse, closed inputs; the style rail is a higher-precedence user layer over them. Structural decisions about the theming code live in "
        },
        {
          "insert": "Theming: Overview",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "30-implementation/40-theming"
            }
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-them-structure-heading": {
      "id": "b-them-structure-heading",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Structure"
        }
      ],
      "children": []
    },
    "b-them-tree": {
      "id": "b-them-tree",
      "type": "file-tree",
      "props": {
        "entries": [
          {
            "path": "themes/<id>/",
            "note": "one theme folder; the folder name is the theme id"
          },
          {
            "path": "themes/<id>/theme.json",
            "note": "manifest: name, optional base and dark mode, font stacks, and rail defaults"
          },
          {
            "path": "themes/<id>/components/",
            "note": "sparse registered component values"
          },
          {
            "path": "themes/<id>/components/code.json",
            "note": "only code values that differ from the base"
          },
          {
            "path": "themes/default/",
            "note": "the living Default"
          }
        ]
      },
      "children": []
    },
    "b-them-manifest-table": {
      "id": "b-them-manifest-table",
      "type": "structured-table",
      "props": {
        "columns": [
          "Manifest field",
          "Meaning"
        ],
        "rows": [
          [
            "name",
            "The theme's display label."
          ],
          [
            "base",
            "The built-in theme this folder layers over."
          ],
          [
            "dark",
            "The light or dark mode the theme declares."
          ],
          [
            "fonts",
            "Optional body, heading, code, and numeric stacks."
          ],
          [
            "railDefaults",
            "The theme's durable style-rail settings."
          ]
        ]
      },
      "children": []
    },
    "b-them-rule-heading": {
      "id": "b-them-rule-heading",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "The Rule"
        }
      ],
      "children": []
    },
    "b-them-reach-heading": {
      "id": "b-them-reach-heading",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "Closed Reach"
        }
      ],
      "children": []
    },
    "b-them-registry": {
      "id": "b-them-registry",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "The "
        },
        {
          "insert": "THEME_TOKEN_REGISTRY",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " allow-list bounds every component file and key a theme may reach."
        }
      ],
      "children": []
    },
    "b-them-sparse": {
      "id": "b-them-sparse",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Component files are sparse; an absent value falls through to the base theme and semantic contract."
        }
      ],
      "children": []
    },
    "b-them-values": {
      "id": "b-them-values",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Unknown files, unknown keys, and malformed mode values are ignored rather than applied."
        }
      ],
      "children": []
    },
    "b-them-resolution-heading": {
      "id": "b-them-resolution-heading",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "Resolution and Selection"
        }
      ],
      "children": []
    },
    "b-them-res-chain": {
      "id": "b-them-res-chain",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A theme resolves over a base chain: the folder's values apply over its named built-in base, and an unknown base ends the chain rather than failing the theme."
        }
      ],
      "children": []
    },
    "b-them-res-shadow": {
      "id": "b-them-res-shadow",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A repository theme shadows a built-in theme with the same id."
        }
      ],
      "children": []
    },
    "b-them-res-modes": {
      "id": "b-them-res-modes",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Every theme resolves to a light and a dark value set; a single scalar value applies to both modes."
        }
      ],
      "children": []
    },
    "b-them-res-select": {
      "id": "b-them-res-select",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Selecting a theme applies its declared mode, adopts its rail defaults as the working settings, and persists as the active selection across sessions."
        }
      ],
      "children": []
    },
    "b-them-res-transfer": {
      "id": "b-them-res-transfer",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Theme settings also travel as an exported file; import validates and normalizes the payload, and an invalid file leaves the active state unchanged."
        }
      ],
      "children": []
    },
    "b-them-authority-table": {
      "id": "b-them-authority-table",
      "type": "structured-table",
      "props": {
        "columns": [
          "Layer",
          "May decide",
          "Precedence"
        ],
        "rows": [
          [
            "Semantic contract",
            "Fallback palette, roles, and geometry",
            "Base"
          ],
          [
            "Theme folder",
            "Registered role values, font stacks, and rail defaults",
            "Over the semantic contract"
          ],
          [
            "Style rail",
            "User values for exposed controls",
            "Over the selected theme"
          ],
          [
            "System UI structure",
            "Unregistered widths, row metrics, and framing",
            "Fixed outside theme reach"
          ]
        ]
      },
      "children": []
    },
    "b-them-default-heading": {
      "id": "b-them-default-heading",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "The Living Default"
        }
      ],
      "children": []
    },
    "b-them-default-living": {
      "id": "b-them-default-living",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Default is the workbench's living theme. Every rail setting, dark toggle, and component override auto-saves into it shortly after the last change; selecting Default restores the saved look."
        }
      ],
      "children": []
    },
    "b-them-default-storage": {
      "id": "b-them-default-storage",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "The saved state is complete: every scalar setting carries a saved value, so Default restores the whole look rather than a diff; component values are saved only where they diverge."
        }
      ],
      "children": []
    },
    "b-them-default-overlay": {
      "id": "b-them-default-overlay",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Active rail overrides still win over the saved values."
        }
      ],
      "children": []
    },
    "b-them-default-authority": {
      "id": "b-them-default-authority",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "The repository copy is the durable authority: browser-local state is a cache and a fallback, and never overrides settings loaded from the repository."
        }
      ],
      "children": []
    },
    "b-them-default-hydrate": {
      "id": "b-them-default-hydrate",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A fresh browser profile hydrates from the repository Default before autosave engages."
        }
      ],
      "children": []
    },
    "b-them-default-locked": {
      "id": "b-them-default-locked",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A theme-locked serve applies the repository Default unconditionally, hides the rail, and rejects theme writes; a static export is read-only."
        }
      ],
      "children": []
    },
    "b-them-boundary-heading": {
      "id": "b-them-boundary-heading",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "The Customization Boundary"
        }
      ],
      "children": []
    },
    "b-them-boundary-contract": {
      "id": "b-them-boundary-contract",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Registered colors, typography, global radius, document layout values, and component tokens may follow a theme. System UI structure stays fixed: unregistered widths, row geometry, visibility breakpoints, and interaction framing do not become theme values. The fixed structure keeps every theme recognizable as the same tool."
        }
      ],
      "children": []
    },
    "b-them-why-heading": {
      "id": "b-them-why-heading",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Why"
        }
      ],
      "children": []
    },
    "b-them-why-safe": {
      "id": "b-them-why-safe",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Hand editing fails safely",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "b-them-why-safe-gloss"
      ]
    },
    "b-them-why-safe-gloss": {
      "id": "b-them-why-safe-gloss",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A typo or unsupported key cannot escape the closed vocabulary and alter an arbitrary application property."
        }
      ],
      "children": []
    },
    "b-them-why-visual": {
      "id": "b-them-why-visual",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Default is adjustable by eye",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "b-them-why-visual-gloss"
      ]
    },
    "b-them-why-visual-gloss": {
      "id": "b-them-why-visual-gloss",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Visual feedback and automatic persistence make the repo's core look quick to tune without a manual export step."
        }
      ],
      "children": []
    },
    "b-them-why-identity": {
      "id": "b-them-why-identity",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Customization is bounded",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "b-them-why-identity-gloss"
      ]
    },
    "b-them-why-identity-gloss": {
      "id": "b-them-why-identity-gloss",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A theme can make the document its own without turning the surrounding workbench into a different product."
        }
      ],
      "children": []
    }
  }
