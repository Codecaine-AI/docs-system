    "b-them-intro": {
      "id": "b-them-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A theme may change registered document-surface roles while fixed system UI structure preserves the tool's identity. Theme folders are sparse, closed inputs; the style rail is a higher-precedence user layer over them. When the host serves it, one Global theme stored outside every repository is the look every project renders and edits. Structural decisions about the theming code live in "
        },
        {
          "insert": "Theming: Overview",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "30-implementation/40-theming"
            }
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-them-structure-heading": {
      "id": "b-them-structure-heading",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Structure"
        }
      ],
      "children": []
    },
    "b-them-tree": {
      "id": "b-them-tree",
      "type": "file-tree",
      "props": {
        "entries": [
          {
            "path": "themes/<id>/",
            "note": "one theme folder; the folder name is the theme id"
          },
          {
            "path": "themes/<id>/theme.json",
            "note": "manifest: name, optional base and dark mode, font stacks, and rail defaults"
          },
          {
            "path": "themes/<id>/components/",
            "note": "sparse registered component values"
          },
          {
            "path": "themes/<id>/components/code.json",
            "note": "only code values that differ from the base"
          },
          {
            "path": "themes/default/",
            "note": "the living Default"
          }
        ]
      },
      "children": []
    },
