        "b-them-global-hosts-export"
      ]
    },
    "b-them-global-hosts-fallback": {
      "id": "b-them-global-hosts-fallback",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A standalone serve on a machine without the docs service state directory keeps per-project theme selection, per-project caches, and repository themes."
        }
      ],
      "children": []
    },
    "b-them-global-hosts-export": {
      "id": "b-them-global-hosts-export",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A static export is read-only. It snapshots the Global theme when the exporting machine has one, and the repository Default otherwise."
        }
      ],
      "children": []
    },
    "b-them-global-scope-lead": {
      "id": "b-them-global-scope-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The Global theme shares the document's look. Workbench layout state stays with each project."
        }
      ],
      "children": []
    },
    "b-them-global-scope-table": {
      "id": "b-them-global-scope-table",
      "type": "structured-table",
      "props": {
        "columns": [
