      ],
      "children": []
    },
    "b-them-global-summary": {
      "id": "b-them-global-summary",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The Global theme is one shared look that every project renders and any project can edit. It has the reserved id "
        },
        {
          "insert": "global",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and lives outside every repository at "
        },
        {
          "insert": "<stateDirectory>/themes/global/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", by default "
        },
        {
          "insert": "~/.local/state/codecaine-docs/themes/global/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The folder has the same shape as a repository theme, with a "
        },
        {
          "insert": "theme.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " manifest and a "
        },
        {
          "insert": "components/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " folder. Its values start from this repository's Default, which sets Inter at 18px, a 1.45 line height, and a "
        },
        {
          "insert": "60ch",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " measure."
        }
      ],
      "children": []
    },
    "b-them-global-edit": {
      "id": "b-them-global-edit",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "One look, edited from any project",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "b-them-global-edit-save",
        "b-them-global-edit-picker"
      ]
    },
    "b-them-global-edit-save": {
      "id": "b-them-global-edit-save",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A style-rail change in any project saves to the Global theme. Every project shows the change on its next load, and open tabs of other projects on the same origin follow it without a reload."
        }
      ],
      "children": []
    },
    "b-them-global-edit-picker": {
      "id": "b-them-global-edit-picker",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "The theme picker lists only "
        },
        {
          "insert": "Global",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ", and the save button reads "
        },
        {
          "insert": "Save global style",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-them-global-authority": {
      "id": "b-them-global-authority",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "The server copy is the authority",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "b-them-global-authority-cache",
        "b-them-global-authority-missing",
        "b-them-global-authority-error"
      ]
    },
    "b-them-global-authority-cache": {
      "id": "b-them-global-authority-cache",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Every project shares one browser cache under "
        },
        {
          "insert": "docs-global:",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " keys. The cache paints the first frame, and the server copy replaces it on load. A per-project cache is never read while the Global theme is active."
        }
      ],
      "children": []
    },
    "b-them-global-authority-missing": {
      "id": "b-them-global-authority-missing",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Until the Global theme is first saved, projects render the stock defaults. The first control change creates the theme."
        }
      ],
      "children": []
    },
    "b-them-global-authority-error": {
      "id": "b-them-global-authority-error",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Any read error other than a missing theme also renders the stock defaults, but it blocks writes. A transient server error therefore cannot overwrite the theme every project shares."
        }
      ],
      "children": []
    },
    "b-them-global-precedence": {
      "id": "b-them-global-precedence",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Precedence",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "b-them-global-precedence-chain"
      ]
    },
    "b-them-global-precedence-chain": {
      "id": "b-them-global-precedence-chain",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "While the Global theme is active, a value resolves from the Global theme, then from the stock defaults. Repository themes do not enter the chain."
        }
      ],
      "children": []
    },
    "b-them-global-hosts": {
      "id": "b-them-global-hosts",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Hosts without a Global theme",
