      "id": "writing-b-writing-use-both-and-eit-28",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Use \"both ... and\", \"either ... or\", or \"if ... then\" when conjunctions could group two ways."
        }
      ],
      "children": []
    },
    "writing-b-writing-write-a-b-or-both-in-29": {
      "id": "writing-b-writing-write-a-b-or-both-in-29",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Write \"a, b, or both\" instead of a slash construction. Write singular or plural directly instead of appending a parenthesized s."
        }
      ],
      "children": []
    },
    "writing-b-writing-give-each-term-one-meani-30": {
      "id": "writing-b-writing-give-each-term-one-meani-30",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Give each term one meaning and each action one name."
