      "children": []
    },
    "writing-b-writing-make-logical-grouping-ex-27": {
      "id": "writing-b-writing-make-logical-grouping-ex-27",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Make logical grouping explicit."
        }
      ],
      "children": [
        "writing-b-writing-use-both-and-eit-28",
