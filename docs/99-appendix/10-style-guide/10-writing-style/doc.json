      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Repeat the noun when \"it\", \"they\", \"this\", or \"which\" could name several things or a whole clause."
        }
      ],
      "children": []
    },
    "writing-b-writing-break-noun-strings-into-22": {
      "id": "writing-b-writing-break-noun-strings-into-22",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Break noun strings into relationships. Write \"the script that checks the import budget\" instead of \"the import budget check script\"."
        }
      ],
      "children": []
    },
    "writing-b-writing-keep-the-small-words-tha-23": {
      "id": "writing-b-writing-keep-the-small-words-tha-23",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Keep the small words that show sentence structure."
        }
      ],
      "children": [
