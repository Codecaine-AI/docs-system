    "b-sg-ws-intro-1": {
      "id": "b-sg-ws-intro-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Write matter-of-fact prose that states what is, in the order the reader needs it. This page defines sentence clarity, punctuation, and the Unslop pattern catalog for the corpus."
        }
      ],
      "children": []
    },
    "b-sg-ws-lead-2": {
      "id": "b-sg-ws-lead-2",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Lead with the fact. The first sentence of a doc or section states the thing itself. No setup, no \"the idea here is\"."
        }
      ],
      "children": []
    },
    "b-sg-ws-one-idea-3": {
      "id": "b-sg-ws-one-idea-3",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "One idea per sentence, one topic per block. A plain lead sentence plus fact bullets beats a paragraph of prose."
        }
      ],
      "children": []
    },
    "b-sg-ws-concrete-4": {
      "id": "b-sg-ws-concrete-4",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Concrete over vague: real numbers, real paths, real names. \"Sixteen types\", never \"several\"."
        }
      ],
      "children": []
    },
    "b-sg-ws-no-preamble-5": {
      "id": "b-sg-ws-no-preamble-5",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "No preamble, no recap, no closing remarks. Start at the answer; stop when it is stated. Tangents move to their own home and get a link, not a sidebar."
        }
      ],
      "children": []
    },
    "b-sg-ws-no-memory-6": {
      "id": "b-sg-ws-no-memory-6",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Assume no memory: a section stands alone or links to what it needs. Never "
        },
        {
          "insert": "as mentioned above",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-sg-ws-present-state-7": {
      "id": "b-sg-ws-present-state-7",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Present-state prose: a finished doc describes what exists now. No change-log voice (\"now\", \"previously\", \"no longer\") unless the doc is explicitly about migration history."
        }
      ],
      "children": []
    },
    "writing-b-writing-write-sentences-to-the-r-1": {
      "id": "writing-b-writing-write-sentences-to-the-r-1",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Write Sentences to the Reader"
        }
      ],
      "children": []
    },
    "writing-b-writing-use-plain-words-and-the-2": {
      "id": "writing-b-writing-use-plain-words-and-the-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Use plain words and the real names from the codebase. Keep a longer sentence when it carries one thought clearly."
        }
      ],
      "children": []
    },
    "writing-b-writing-address-the-reader-as-y-3": {
      "id": "writing-b-writing-address-the-reader-as-y-3",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Address the reader as \"you\" and use the present tense."
        }
      ],
      "children": [
        "writing-b-writing-reserve-will-for-a-lat-4"
      ]
    },
    "writing-b-writing-reserve-will-for-a-lat-4": {
      "id": "writing-b-writing-reserve-will-for-a-lat-4",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Reserve \"will\" for a later event. Do not announce uncommitted features."
        }
      ],
      "children": []
    },
    "writing-b-writing-name-the-actor-and-actio-5": {
      "id": "writing-b-writing-name-the-actor-and-actio-5",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Name the actor and action."
        }
      ],
      "children": [
        "writing-b-writing-write-the-compiler-chec-6"
      ]
    },
    "writing-b-writing-write-the-compiler-chec-6": {
      "id": "writing-b-writing-write-the-compiler-chec-6",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Write \"the compiler checks the schema\" instead of \"the schema is checked\". Passive voice fits when the actor is unknown or irrelevant."
        }
      ],
      "children": []
    },
    "writing-b-writing-write-instructions-as-di-7": {
      "id": "writing-b-writing-write-instructions-as-di-7",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Write instructions as direct commands."
        }
      ],
      "children": [
        "writing-b-writing-put-the-condition-or-war-8",
        "writing-b-writing-give-each-sentence-one-i-9"
      ]
    },
    "writing-b-writing-put-the-condition-or-war-8": {
      "id": "writing-b-writing-put-the-condition-or-war-8",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Put the condition or warning before the action it guards. Put the common case before exceptions."
        }
      ],
      "children": []
    },
    "writing-b-writing-give-each-sentence-one-i-9": {
      "id": "writing-b-writing-give-each-sentence-one-i-9",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Give each sentence one instruction. Review instructions over about 20 words and other sentences over about 25 words. Split at a second thought, not at an arbitrary count."
        }
      ],
      "children": []
    },
    "writing-b-writing-use-the-short-everyday-10": {
      "id": "writing-b-writing-use-the-short-everyday-10",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Use the short, everyday word."
        }
      ],
      "children": [
        "writing-b-writing-replace-utilize-and-l-11",
        "writing-b-writing-cut-words-that-add-nothi-12"
      ]
    },
    "writing-b-writing-replace-utilize-and-l-11": {
      "id": "writing-b-writing-replace-utilize-and-l-11",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Replace \"utilize\" and \"leverage\" with \"use\", \"facilitate\" with \"help\", \"numerous\" with \"many\", and \"in the event that\" with \"if\"."
        }
      ],
      "children": []
    },
    "writing-b-writing-cut-words-that-add-nothi-12": {
      "id": "writing-b-writing-cut-words-that-add-nothi-12",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Cut words that add nothing. Keep words that prevent a second reading."
        }
      ],
      "children": []
    },
    "writing-b-writing-write-like-a-knowledgeab-13": {
      "id": "writing-b-writing-write-like-a-knowledgeab-13",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Write like a knowledgeable colleague."
        }
      ],
      "children": [
        "writing-b-writing-omit-please-simply-14",
        "writing-b-writing-vary-sentence-lengths-a-15"
      ]
    },
    "writing-b-writing-omit-please-simply-14": {
      "id": "writing-b-writing-omit-please-simply-14",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Omit \"please\", \"simply\", \"easy\", and \"quickly\" from procedures. Read an awkward sentence aloud and rewrite it if it stays awkward."
        }
      ],
      "children": []
    },
    "writing-b-writing-vary-sentence-lengths-a-15": {
      "id": "writing-b-writing-vary-sentence-lengths-a-15",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Vary sentence lengths. Avoid consecutive sentences with the same opening. Give a view when the document's purpose calls for judgment."
        }
      ],
      "children": []
    },
    "writing-b-writing-remove-ambiguity-16": {
      "id": "writing-b-writing-remove-ambiguity-16",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Remove Ambiguity"
        }
      ],
      "children": []
    },
    "writing-b-writing-each-sentence-has-one-cl-17": {
      "id": "writing-b-writing-each-sentence-has-one-cl-17",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Each sentence has one clear reading. Use the real symbol, file, flag, or command name instead of rotating synonyms."
        }
      ],
      "children": []
    },
    "writing-b-writing-keep-modifiers-next-to-t-18": {
      "id": "writing-b-writing-keep-modifiers-next-to-t-18",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Keep modifiers next to the words they change."
        }
      ],
      "children": [
        "writing-b-writing-fails-only-on-growth-l-19"
      ]
    },
    "writing-b-writing-fails-only-on-growth-l-19": {
      "id": "writing-b-writing-fails-only-on-growth-l-19",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "\"Fails only on growth\" limits when failure happens. \"Only fails on growth\" can limit what happens."
        }
      ],
      "children": []
    },
    "writing-b-writing-give-every-pronoun-one-o-20": {
      "id": "writing-b-writing-give-every-pronoun-one-o-20",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Give every pronoun one obvious referent."
        }
      ],
      "children": [
        "writing-b-writing-repeat-the-noun-when-it-21",
        "writing-b-writing-break-noun-strings-into-22"
      ]
    },
