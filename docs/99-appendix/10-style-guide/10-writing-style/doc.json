      "id": "writing-b-writing-use-start-consistently-31",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Use \"start\" consistently instead of alternating with \"initiate\". Avoid ambiguous words ending in \"-ing\" when a direct verb is clearer."
        }
      ],
      "children": []
    },
    "writing-b-writing-avoid-idioms-latin-abbr-32": {
