        "sg-struct-shape-group-lists"
      ]
    },
    "b-sg-struct-intro-1": {
      "id": "b-sg-struct-intro-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Page structure carries meaning through bullets, lists, headings, titles, and openings. The join test keeps bullet groups complete enough to read as prose."
        }
      ],
      "children": []
    },
    "b-sg-struct-bullets-2": {
      "id": "b-sg-struct-bullets-2",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Bullets Carry Prose Meaning",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "shape-detail-0-0",
        "shape-detail-0-1",
        "shape-detail-0-2"
      ]
    },
    "shape-detail-0-0": {
      "id": "shape-detail-0-0",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Use bullets as the default reading shape. A lead sentence states the claim, and each bullet is a complete sentence with its relationships and qualifiers attached."
        }
      ],
      "children": []
    },
    "shape-detail-0-1": {
      "id": "shape-detail-0-1",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Apply the join test. The lead plus the bullets, read in order, should reconstruct a well-written paragraph."
        }
      ],
      "children": []
    },
    "shape-detail-0-2": {
      "id": "shape-detail-0-2",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Consecutive fragments with the same subject, such as \"X carries A\" and \"X carries B\", can mean that the sentence relating the facts was deleted."
        }
      ],
      "children": []
    },
    "b-sg-struct-lead-gloss-3": {
      "id": "b-sg-struct-lead-gloss-3",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Separate the Lead From Its Gloss",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "shape-detail-1-0",
        "shape-detail-1-1"
      ]
    },
    "shape-detail-1-0": {
      "id": "shape-detail-1-0",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Put a bold label, a link, or a short phrase in a parent bullet that has 3 or more facts in sub-bullets. Write 1 or 2 facts as plain bullets, and name a section of the page with a heading, not a bullet."
        }
      ],
      "children": []
    },
    "shape-detail-1-1": {
      "id": "shape-detail-1-1",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Nest a second independent idea instead of packing the line. Never split one thought into fragments to manufacture nesting."
        }
      ],
      "children": []
    },
    "b-sg-struct-no-reenumerate-4": {
      "id": "b-sg-struct-no-reenumerate-4",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Avoid Duplicating Structured Blocks",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "shape-detail-2-0",
        "shape-detail-2-1"
      ]
    },
    "shape-detail-2-0": {
      "id": "shape-detail-2-0",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Writing before a table or state-shape orients the reader. Bullets that restate its rows are duplication that will drift."
        }
      ],
      "children": []
    },
    "shape-detail-2-1": {
      "id": "shape-detail-2-1",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A structured block draws only what the source does. A step that returns early is a branch, an arrow is a real import or call, and a count in the prose equals the count in the block."
        }
      ],
      "children": []
    },
    "b-sg-struct-lists-5": {
      "id": "b-sg-struct-lists-5",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Number Sequential Actions",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "shape-detail-3-0",
        "shape-detail-3-1"
      ]
    },
    "shape-detail-3-0": {
      "id": "shape-detail-3-0",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Use a numbered list for multi-step work, with one bounded action per step."
        }
      ],
      "children": []
    },
    "shape-detail-3-1": {
      "id": "shape-detail-3-1",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Lists cap at about five items. Split or rank longer lists."
        }
      ],
      "children": []
    },
    "b-sg-struct-headings-6": {
      "id": "b-sg-struct-headings-6",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Make Headings Useful for Scanning",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "shape-detail-4-0",
        "shape-detail-4-1",
        "shape-detail-4-2",
        "shape-detail-4-3"
      ]
    },
    "shape-detail-4-0": {
      "id": "shape-detail-4-0",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Keep a section short enough to scan in one screen. Use Title Case headings, leaving minor words lowercase and preserving acronyms and code-marked spans."
        }
      ],
      "children": []
    },
    "shape-detail-4-1": {
      "id": "shape-detail-4-1",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "The display title and body headings are separate."
        }
      ],
      "children": [
        "shape-detail-4-1-0"
      ]
    },
    "shape-detail-4-1-0": {
      "id": "shape-detail-4-1-0",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "H1 headings are allowed in the body. Do not begin the body with an H1 that repeats the display title."
        }
      ],
      "children": []
    },
    "shape-detail-4-2": {
      "id": "shape-detail-4-2",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Preserve meaningful heading levels."
        }
      ],
      "children": []
    },
    "shape-detail-4-3": {
      "id": "shape-detail-4-3",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Standards and design docs share the flow Structure, The Rule, and Why."
        }
      ],
      "children": []
    },
    "b-sg-struct-title-opener-7": {
      "id": "b-sg-struct-title-opener-7",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Give Each Page a Distinct Title and Opening",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "shape-detail-5-0",
        "shape-detail-5-1"
      ]
    },
    "shape-detail-5-0": {
      "id": "shape-detail-5-0",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "The title differentiates the doc from its siblings in a bare listing. Use \"Component Themes\", not \"Themes, Continued\"."
        }
      ],
      "children": []
    },
    "shape-detail-5-1": {
      "id": "shape-detail-5-1",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Open the body with a paragraph of 2 to 4 sentences so a reader arriving mid-corpus can judge relevance without reading the rest."
        }
      ],
      "children": []
    },
    "shape-b-shape-keep-the-skim-path-clear-1": {
      "id": "shape-b-shape-keep-the-skim-path-clear-1",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Keep the Skim Path Clear"
        }
      ],
      "children": []
    },
    "shape-b-shape-headings-and-lists-expos-2": {
      "id": "shape-b-shape-headings-and-lists-expos-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Headings and lists expose the order in which a reader needs information."
        }
      ],
      "children": []
    },
    "shape-b-shape-use-a-bare-verb-phrase-f-3": {
      "id": "shape-b-shape-use-a-bare-verb-phrase-f-3",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Use a bare verb phrase for a task heading and a noun phrase for a concept heading. Do not skip heading levels."
        }
      ],
      "children": []
    },
    "shape-b-shape-introduce-a-list-with-a-4": {
      "id": "shape-b-shape-introduce-a-list-with-a-4",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Introduce a list with a complete sentence and keep its items parallel."
        }
      ],
      "children": []
    },
    "shape-b-shape-preserve-the-established-5": {
      "id": "shape-b-shape-preserve-the-established-5",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Preserve the established page template. Supporting reasons or reference details can serve the page's primary purpose, as defined in "
        },
        {
          "insert": "Document Purpose",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "docs/10-system-design/10-doc-standards/70-document-purpose"
            }
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "shape-image-alt-guidance": {
      "id": "shape-image-alt-guidance",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Give every image nonempty alt text that describes the information it contributes."
        }
      ],
      "children": []
    },
    "852df798-83f6-4853-86e3-02d48a841bdb": {
      "id": "852df798-83f6-4853-86e3-02d48a841bdb",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Show the Shape in a Typed Block"
        }
      ],
      "children": []
    },
    "22bcd44c-7ec9-47db-a26f-8f7f248e5e47": {
      "id": "22bcd44c-7ec9-47db-a26f-8f7f248e5e47",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Typed blocks are the main value of this docs system. A typed block shows a shape that bullets can only describe. Before you write a section as prose or bullets, check whether it describes one of the shapes in this table."
        }
      ],
      "children": []
    },
    "85998fe4-8918-4545-8d1b-db40087ffab5": {
      "id": "85998fe4-8918-4545-8d1b-db40087ffab5",
      "type": "structured-table",
      "props": {
        "columns": [
          "Shape in the section",
          "Typed block"
        ],
        "rows": [
          [
            "Data fields and an example instance",
            [
              {
                "insert": "state-shape",
                "attributes": {
                  "code": true
                }
              }
            ]
          ],
          [
            "Files and folders",
            [
              {
                "insert": "file-tree",
                "attributes": {
                  "code": true
                }
              }
            ]
          ],
          [
            "Expected execution path of a system",
            [
              {
                "insert": "process-outline",
                "attributes": {
                  "code": true
                }
              }
            ]
          ],
          [
            "Operations on a state",
            [
              {
                "insert": "interaction-surface",
                "attributes": {
                  "code": true
                }
              }
            ]
          ],
          [
            "Layers and the rule at each line",
            [
              {
                "insert": "stack",
                "attributes": {
                  "code": true
                }
              }
            ]
          ],
          [
            "Connections, ownership, or a pipeline",
            [
              {
                "insert": "canvas",
                "attributes": {
                  "code": true
                }
              }
            ]
          ],
          [
            "Calls and returns between participants",
            [
              {
                "insert": "sequence",
                "attributes": {
                  "code": true
                }
              }
            ]
          ],
          [
            "Rows that compare the same fields",
            [
              {
                "insert": "structured-table",
                "attributes": {
                  "code": true
                }
              }
            ]
          ],
          [
            "A screen or a physical layout",
            [
              {
                "insert": "html",
                "attributes": {
                  "code": true
                }
              }
            ]
          ]
        ],
        "title": "Shapes and the typed block for each"
      },
      "children": []
    },
    "sg-struct-shape-group-use": {
      "id": "sg-struct-shape-group-use",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Use the Typed Block When the Shape Is There",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "sg-struct-shape-use",
        "sg-struct-shape-specs",
        "sg-struct-shape-example"
      ]
    },
    "sg-struct-shape-use": {
      "id": "sg-struct-shape-use",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "If the section describes a shape, use its typed block. Put one or two sentences around the block to orient the reader."
        }
      ],
      "children": []
    },
    "sg-struct-shape-specs": {
      "id": "sg-struct-shape-specs",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Specs, plans, and design pages need typed blocks most. Readers align on these pages, and they align faster when they can see the shape."
        }
      ],
      "children": []
    },
    "sg-struct-shape-example": {
      "id": "sg-struct-shape-example",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A spec that lists the nine fields of a record as bullets breaks this rule. One "
        },
        {
          "insert": "state-shape",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " block with the fields and a JSON example follows it."
        }
      ],
      "children": []
    },
    "sg-struct-shape-group-lists": {
      "id": "sg-struct-shape-group-lists",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Keep Lists Where Lists Fit",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "sg-struct-shape-keep-list",
        "sg-struct-shape-keep-steps"
      ]
    },
    "sg-struct-shape-keep-list": {
      "id": "sg-struct-shape-keep-list",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Keep a short list of plain facts as a list. Never force a fact into a diagram only to have one."
        }
      ],
      "children": []
    },
    "sg-struct-shape-keep-steps": {
      "id": "sg-struct-shape-keep-steps",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Keep steps that the reader follows as a numbered list, as Number Sequential Actions says."
        }
      ],
      "children": []
    }
  }
}
