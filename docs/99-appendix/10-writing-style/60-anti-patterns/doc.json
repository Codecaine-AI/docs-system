        "b-ws-anti-intro-1",
        "b-ws-anti-essay-2",
        "b-ws-anti-vague-3",
        "b-ws-anti-buried-4",
        "b-ws-anti-sidebars-5",
        "b-ws-anti-long-callouts-6",
        "b-ws-anti-atomized-7",
        "b-ws-anti-row-echo-8"
      ]
    },
    "b-ws-anti-intro-1": {
      "id": "b-ws-anti-intro-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The shapes that mark a doc as needing repair. Each is named so a review can point at what is wrong in one term."
        }
      ],
      "children": []
    },
    "b-ws-anti-essay-2": {
      "id": "b-ws-anti-essay-2",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Essay prose: rhetorical setup, thesis paragraphs, “the idea here is that”."
        }
      ],
      "children": []
    },
    "b-ws-anti-vague-3": {
      "id": "b-ws-anti-vague-3",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Vague quantities (“several”, “a few”, “some work”)."
        }
      ],
      "children": []
    },
    "b-ws-anti-buried-4": {
      "id": "b-ws-anti-buried-4",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Buried facts: a fact that only appears mid-paragraph instead of leading a sentence or bullet."
        }
      ],
      "children": []
    },
    "b-ws-anti-sidebars-5": {
      "id": "b-ws-anti-sidebars-5",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Sidebars (“by the way”, “note that also…”) — file them where they belong."
        }
      ],
      "children": []
    },
    "b-ws-anti-long-callouts-6": {
      "id": "b-ws-anti-long-callouts-6",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Multi-paragraph callouts: if the admonition needs more than two sentences, the overflow is a section, not callout body."
        }
      ],
      "children": []
    },
    "b-ws-anti-atomized-7": {
      "id": "b-ws-anti-atomized-7",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Atomized bullets: consecutive fragments sharing one subject and verb shape (“X carries A.” / “X carries B.”) — the relating sentence was deleted. Bullets must carry prose-complete meaning, not stripped nouns."
        }
      ],
      "children": []
    },
    "b-ws-anti-row-echo-8": {
      "id": "b-ws-anti-row-echo-8",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Row-echo prose: bullets that restate an adjacent table or state-shape one line per row."
        }
      ],
      "children": []
    }
  }
}
