        {
          "insert": "theme-folders.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " into both mode blocks, and rail font choices map to built-in stack strings in "
        },
        {
          "insert": "styleRailVars",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". No font-binary or "
        },
        {
          "insert": "@font-face",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " loading path exists, so a stack resolves only against families the browser or host already provides."
