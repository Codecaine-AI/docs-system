      "id": "b-thm-impl-d-fonts-decision",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Decision: Font stacks flow through the same two theming paths as every other value. Manifest font strings compile through "
