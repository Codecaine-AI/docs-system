    "b-thm-impl-d-layers-decision": {
      "id": "b-thm-impl-d-layers-decision",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Decision: Each design precedence layer is realized as a distinct CSS mechanism. Base values are static stylesheets ("
        },
        {
          "insert": "notion-palette.css",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " raw variables mapped by "
        },
        {
          "insert": "semantic.css",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "), the selected theme is one injected style element compiled from the theme folder with a light and a dark block, and style-rail state is inline custom properties on the root element."
        }
      ],
      "children": []
    },
    "b-thm-impl-d-layers-why": {
      "id": "b-thm-impl-d-layers-why",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Why: Merging the layers into one computed set at runtime was rejected. CSS arbitration (inline over injected over stylesheet) carries the design's precedence order, so no application code re-implements it."
        }
      ],
      "children": []
    },
    "b-thm-impl-d-layers-applies": {
      "id": "b-thm-impl-d-layers-applies",
