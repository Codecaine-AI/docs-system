    "b-dc-dialect-h": {
      "id": "b-dc-dialect-h",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "The command dialect is durable"
        }
      ],
      "children": []
    },
    "b-dc-dialect-d": {
      "id": "b-dc-dialect-d",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Decision: Command names, arguments, stdout shapes, and exit behavior are a stable contract — verification commands fail through exit status ("
        },
        {
          "insert": "links check",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " on stale references, "
        },
        {
          "insert": "audit",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " on structural errors while warnings stay informational); new capability extends the dialect rather than breaking it."
        }
      ],
      "children": []
    },
    "b-dc-dialect-w": {
      "id": "b-dc-dialect-w",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Why: Repository instructions, scripts, and agent tools gate work on command vocabulary and failure semantics, not workbench UI state — the process boundary must outlive UI refactors and holds whether or not the package ever merges into the workbench. Rejected: treating the CLI as an internal detail of the app shell."
        }
      ],
      "children": []
    },
    "b-dc-dialect-a": {
      "id": "b-dc-dialect-a",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Applies to: "
        },
        {
          "insert": "packages/docs-cli/src/index.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " — every future command and flag."
        }
      ],
      "children": []
    },
    "b-dc-leaf-h": {
      "id": "b-dc-leaf-h",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "The executable is a leaf"
        }
      ],
      "children": []
    },
    "b-dc-leaf-d": {
      "id": "b-dc-leaf-d",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Decision: No library module imports docs-cli; reusable logic lives in the packages below it, and the entrypoint dispatches argv only when executed as the CLI. "
        },
        {
          "insert": "serve",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "export",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " dynamically import docs-workbench instead of duplicating its server, route table, or export layer."
        }
      ],
      "children": []
    },
    "b-dc-leaf-w": {
      "id": "b-dc-leaf-w",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Why: Importing helpers must not start the command parser or the browser stack. Rejected: putting reusable logic in the CLI, which would force consumers through the executable."
        }
      ],
      "children": []
    },
    "b-dc-leaf-a": {
      "id": "b-dc-leaf-a",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Applies to: "
        },
        {
          "insert": "packages/docs-cli",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " — future shared logic lands in a lower package, not here."
        }
      ],
      "children": []
    },
    "b-dc-effects-h": {
      "id": "b-dc-effects-h",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "Side effects stay command-explicit"
        }
      ],
      "children": []
    },
    "b-dc-effects-d": {
      "id": "b-dc-effects-d",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Decision: "
        },
        {
          "insert": "render",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "grep",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " never write; backlink and link commands replace only derived SQLite state; migration, serve, and export confine writes to the selected repository, docs root, build directory, or output directory."
        }
      ],
      "children": []
    },
    "b-dc-effects-w": {
      "id": "b-dc-effects-w",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Why: A scriptable surface must be safe to call from automation without surprise writes. Rejected: commands with implicit side effects outside their declared scope."
        }
      ],
      "children": []
    },
    "b-dc-effects-a": {
      "id": "b-dc-effects-a",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Applies to: "
        },
        {
          "insert": "packages/docs-cli/src",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " — every future command declares and confines its write scope."
        }
      ],
      "children": []
    },
    "b-dc-migrate-h": {
      "id": "b-dc-migrate-h",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "Migration stays below the dispatcher and never deletes by default"
        }
      ],
      "children": []
    },
    "b-dc-migrate-d": {
      "id": "b-dc-migrate-d",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Decision: Adoption machinery lives in its own "
        },
        {
          "insert": "packages/docs-cli/src/migrate",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "packages/docs-cli/src/migrate"
            }
          }
        },
        {
          "insert": " directory, separate from steady-state commands. Ordinary migration writes bundles alongside Markdown sources without modifying or deleting them; retirement is a separate "
        },
        {
          "insert": "--retire-twins",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " branch that requires "
        },
        {
          "insert": "--yes-delete-markdown",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for a real deletion."
        }
      ],
      "children": []
    },
    "b-dc-migrate-w": {
      "id": "b-dc-migrate-w",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Why: Adoption is not steady-state reading, and a converter that silently destroys its sources was rejected — deletion is a separate, doubly confirmed act."
        }
      ],
      "children": []
    },
    "b-dc-migrate-a": {
      "id": "b-dc-migrate-a",
