      "children": []
    },
    "b-dc-effects-w": {
      "id": "b-dc-effects-w",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Why: A scriptable surface must be safe to call from automation without surprise writes. Rejected: commands with implicit side effects outside their declared scope."
        }
      ],
      "children": []
    },
    "b-dc-effects-a": {
      "id": "b-dc-effects-a",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Applies to: "
        },
        {
          "insert": "packages/docs-cli/src",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Every future command declares and confines its write scope."
        }
      ],
      "children": []
    },
    "b-dc-migrate-h": {
      "id": "b-dc-migrate-h",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "Migration stays below the dispatcher and never deletes by default"
        }
      ],
      "children": []
    },
    "b-dc-migrate-d": {
      "id": "b-dc-migrate-d",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Decision: Adoption machinery lives in its own "
        },
        {
          "insert": "packages/docs-cli/src/migrate",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "packages/docs-cli/src/migrate"
            }
          }
        },
        {
          "insert": " directory, separate from steady-state commands. Ordinary migration writes bundles alongside Markdown sources without changing or deleting them; retirement is a separate "
        },
        {
          "insert": "--retire-twins",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " branch that requires "
        },
        {
          "insert": "--yes-delete-markdown",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for a real deletion."
        }
      ],
      "children": []
    },
    "b-dc-migrate-w": {
      "id": "b-dc-migrate-w",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Why: Adoption is not steady-state reading, and a converter that silently destroys its sources was rejected. Deletion is a separate, doubly confirmed act."
        }
      ],
      "children": []
    },
    "b-dc-migrate-a": {
      "id": "b-dc-migrate-a",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Applies to: "
        },
        {
          "insert": "packages/docs-cli/src/migrate",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Future adoption tooling lands here under the same safety split."
        }
      ],
      "children": []
    },
