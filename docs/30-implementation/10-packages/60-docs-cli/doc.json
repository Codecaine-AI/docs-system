    "b-dc-dialect-d-1": {
      "id": "b-dc-dialect-d-1",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Command names, arguments, stdout shapes, and exit behavior are a stable contract."
        }
      ],
      "children": []
    },
    "b-dc-dialect-d-2": {
      "id": "b-dc-dialect-d-2",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Verification commands fail through exit status. "
        },
        {
          "insert": "links check",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " fails on stale references, and "
        },
        {
          "insert": "audit",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " fails on structural errors while warnings stay informational."
        }
      ],
      "children": []
    },
    "b-dc-dialect-d-3": {
      "id": "b-dc-dialect-d-3",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "New capability extends the dialect rather than breaking it."
        }
      ],
      "children": []
    },
    "b-dc-dialect-w": {
      "id": "b-dc-dialect-w",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Why",
          "attributes": {
            "bold": true
          }
        }
