    },
    "b-dc-dialect-w-1": {
      "id": "b-dc-dialect-w-1",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Repository instructions, scripts, and agent tools gate work on command vocabulary and failure semantics, not on workbench UI state."
        }
      ],
      "children": []
    },
    "b-dc-dialect-w-2": {
      "id": "b-dc-dialect-w-2",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "The process boundary must outlive UI refactors, and it holds whether or not the package ever merges into the workbench."
        }
      ],
      "children": []
    },
    "b-dc-dialect-w-3": {
      "id": "b-dc-dialect-w-3",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Treating the CLI as an internal detail of the app shell was rejected."
        }
      ],
      "children": []
    },
    "b-dc-dialect-a": {
      "id": "b-dc-dialect-a",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Applies to",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "b-dc-dialect-a-1"
      ]
    },
    "b-dc-dialect-a-1": {
      "id": "b-dc-dialect-a-1",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "The rule covers "
        },
        {
          "insert": "packages/docs-cli/src/index.ts",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "packages/docs-cli/src/index.ts"
            }
          }
        },
        {
          "insert": " and every future command and flag."
        }
