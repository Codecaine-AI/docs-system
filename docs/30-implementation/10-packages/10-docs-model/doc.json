      "id": "b-dm-pure-a",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Applies to: "
        },
        {
          "insert": "packages/docs-model/src",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " — every future module in the package; enforced by "
        },
        {
          "insert": "import-boundaries.test.ts",
          "attributes": {
            "code": true,
