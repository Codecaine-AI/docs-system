    "b-dm-bundle-w": {
      "id": "b-dm-bundle-w",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Why: State, update logic, and the agent render travel together, so adding a type touches one bundle per home instead of scattered files. Rejected: role-grouped layout (all schemas together, all actions together), which spreads one component across the tree."
        }
      ],
      "children": []
