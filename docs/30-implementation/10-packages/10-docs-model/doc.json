    "b-dm-modules-d": {
      "id": "b-dm-modules-d",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Decision: Everything the data model defines is defined in this package, one authority module per contract: "
        },
        {
          "insert": "src/doc-schema.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " owns the envelope, full-document validation, traversal order, and the canonical serializer; "
        },
        {
          "insert": "src/doc-ops.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " owns the typed operation kernel and inverses; "
        },
        {
          "insert": "src/annotations-schema.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " owns the sidecar schema; "
        },
        {
          "insert": "src/discovery.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " owns agent discovery; and "
        },
        {
          "insert": "src/project-markdown.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " with "
        },
        {
          "insert": "src/markdown-to-delta.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "src/delta-markdown.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " own the agent-facing text forms. Consumers call these modules; they do not reimplement validation or serialization."
        }
      ],
      "children": []
    },
    "b-dm-modules-w": {
      "id": "b-dm-modules-w",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Why: Canonical bytes and hashes only work if every write path round-trips through one validator and one serializer; scattering those contracts across consumers was rejected because a second implementation drifts and pollutes diffs and hashes."
        }
      ],
      "children": []
    },
    "b-dm-modules-a": {
      "id": "b-dm-modules-a",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Applies to: "
        },
        {
          "insert": "packages/docs-model/src",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " — a new format contract lands here as its own module, never inside a consumer package."
        }
      ],
      "children": []
    },
