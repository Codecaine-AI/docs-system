    "b-dm-registry-w": {
      "id": "b-dm-registry-w",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Why: Controlled extensibility keeps the block set closed and the allow-list a deliberate review point. Rejected: run-time plug-in discovery and filesystem-scan auto-registration."
        }
      ],
      "children": []
    },
    "b-dm-registry-a": {
      "id": "b-dm-registry-a",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Applies to: "
        },
        {
          "insert": "packages/docs-model/src/components/index.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
