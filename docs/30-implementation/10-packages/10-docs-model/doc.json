    },
    "b-dm-registry-d": {
      "id": "b-dm-registry-d",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Decision: "
        },
        {
          "insert": "src/components/index.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " keeps the "
