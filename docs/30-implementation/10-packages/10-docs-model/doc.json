    "b-dm-actions-d": {
      "id": "b-dm-actions-d",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Decision: A component's typed actions live one file per action under its bundle's "
        },
        {
          "insert": "actions/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " directory, keyed "
        },
        {
          "insert": "<type>.<verb>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and built with "
        },
        {
          "insert": "defineComponentAction",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "; a local action's pure "
        },
        {
          "insert": "apply",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " returns a props patch. Components whose authority is external — canvas, sequence — lift their descriptors from the external package's "
        },
        {
          "insert": "agent-schema",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in an "
        },
        {
          "insert": "actions/lift.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and mark them "
        },
        {
          "insert": "forward: { authority }",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " with no local apply. Named actions exist only for mutations with positional or keyed collection semantics; scalar props and block text change through "
        },
        {
          "insert": "updateBlock",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
