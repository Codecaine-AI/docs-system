              "kind": "doc",
              "path": "10-system-design/30-data-model/40-serialization",
              "label": "Serialization"
            }
          }
        },
        {
          "insert": " — canonical bytes and the content hashes that make write preconditions possible."
        }
      ],
      "children": []
    },
    "b-ds-decisions-h": {
      "id": "b-ds-decisions-h",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Decisions"
        }
      ],
      "children": []
    },
    "b-ds-sole-h": {
      "id": "b-ds-sole-h",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "The server is the sole mutation authority"
        }
      ],
      "children": []
    },
    "b-ds-sole-d": {
      "id": "b-ds-sole-d",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Decision: Every accepted write goes through the ops path in "
        },
        {
          "insert": "packages/docs-server/src/doc-ops.ts",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "packages/docs-server/src/doc-ops.ts"
            }
          }
        },
        {
          "insert": " — behind "
        },
        {
          "insert": "POST /api/ops",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and the direct agent tools alike — with an expected-hash guard, a per-path mutex around the whole read-check-apply-write sequence, atomic temp-then-rename persistence, and inverse ops recorded in the undo ledger. Undo re-enters the same guarded path. No client, tool, or secondary route writes document bytes."
        }
      ],
      "children": []
    },
    "b-ds-sole-w": {
      "id": "b-ds-sole-w",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Why: Hash preconditions, validation, undo, and change events stay consistent only when there is exactly one guarded critical section. Client-side writes and parallel write paths were rejected — a second path would bypass those guarantees and give agents a weaker authority."
        }
      ],
      "children": []
    },
    "b-ds-sole-a": {
      "id": "b-ds-sole-a",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Applies to: "
        },
        {
          "insert": "packages/docs-server/src/doc-ops.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "packages/docs-server/src/routes.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "packages/docs-server/src/agent-tools.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " — every future mutation surface converges on this path."
        }
      ],
      "children": []
    },
    "b-ds-embed-h": {
      "id": "b-ds-embed-h",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "Embeddable and React-free"
        }
      ],
      "children": []
    },
    "b-ds-embed-d": {
      "id": "b-ds-embed-d",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Decision: The package exposes "
        },
        {
          "insert": "createDocsStore",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and the "
        },
        {
          "insert": "createDocsRoutes",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " Elysia route factory mounted under "
        },
        {
          "insert": "/api/*",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "; it depends on no React, docs-viewer, or docs-workbench code."
        }
      ],
      "children": []
    },
    "b-ds-embed-w": {
      "id": "b-ds-embed-w",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Why: Host embeddability is the forcing constraint — a host mounts the route factory in its own server and brings its own UI. A viewer or React dependency was rejected because it would force every host to carry the browser stack."
        }
      ],
      "children": []
    },
    "b-ds-embed-a": {
      "id": "b-ds-embed-a",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Applies to: "
        },
        {
          "insert": "packages/docs-server",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " — future server capability lands behind the store and route factory."
        }
      ],
      "children": []
    },
    "b-ds-root-h": {
      "id": "b-ds-root-h",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "A docs root is the unit of authority"
        }
      ],
      "children": []
    },
    "b-ds-root-d": {
      "id": "b-ds-root-d",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Decision: "
        },
        {
          "insert": "createDocsStore(docsRoot)",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in "
        },
        {
          "insert": "packages/docs-server/src/store.ts",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "packages/docs-server/src/store.ts"
            }
          }
        },
        {
          "insert": " binds every method to one resolved root and accepts root-relative paths; the package holds no project identifiers, project records, or host database connections. A host resolves its own workspace, project, or command-line selection to a docs root before entering the package."
        }
      ],
      "children": []
    },
    "b-ds-root-w": {
      "id": "b-ds-root-w",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Why: Filesystem and concurrency policy belong to the server; application identity, authentication, and routing outside "
        },
        {
          "insert": "/api/*",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " belong to hosts. A project-aware server was rejected — it would pull every host's identity model into the reusable package."
        }
      ],
      "children": []
    },
    "b-ds-root-a": {
      "id": "b-ds-root-a",
      "type": "list-item",
      "props": {
