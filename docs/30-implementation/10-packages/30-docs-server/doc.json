      "id": "b-ds-role",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The React-free mutation authority for one filesystem-backed docs tree — reads, preconditioned writes, undo, locks, and change events, exposed as a TypeScript store and an embeddable route factory. Source: "
        },
        {
          "insert": "packages/docs-server",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "packages/docs-server"
            }
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-ds-gov-h": {
      "id": "b-ds-gov-h",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Governed By"
        }
      ],
      "children": []
    },
    "b-ds-gov-mut": {
      "id": "b-ds-gov-mut",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The mutation model",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/30-data-model/50-mutation-model",
              "label": "The mutation model"
            }
          }
        },
        {
          "insert": " — op semantics, inverses, undo, and refusal behavior the server's write path realizes."
        }
      ],
      "children": []
    },
    "b-ds-gov-ser": {
      "id": "b-ds-gov-ser",
      "type": "paragraph",
      "props": {},
