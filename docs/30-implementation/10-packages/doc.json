    "b-pkga-roster-workbench": {
      "id": "b-pkga-roster-workbench",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "docs-workbench",
          "attributes": {
            "reference": {
