    "b-pkga-role": {
      "id": "b-pkga-role",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Structural decisions for the workspace package cut — how the docs system's code divides into packages and why the walls sit where they do. Source: "
        },
        {
          "insert": "packages/",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "packages"
            }
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "external/",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "external"
            }
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-pkga-gov-h": {
      "id": "b-pkga-gov-h",
