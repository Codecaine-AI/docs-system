    "b-fw-authority-d": {
      "id": "b-fw-authority-d",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Decision: The docs corpus is the sole home of every structural rule. This package carries no standard copies; standing agent knowledge renders from the corpus doc.json bundles through the agent markdown projection at context-assembly time."
        }
      ],
      "children": []
    },
    "b-fw-authority-w": {
      "id": "b-fw-authority-w",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Why: Framework must not become a second decision-memory home. A copy tier requires hand synchronization and drifts toward teaching retired conventions; rendering from the corpus leaves one canonical text and nothing to synchronize."
        }
      ],
      "children": []
    },
    "b-fw-authority-a": {
      "id": "b-fw-authority-a",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Applies to: "
        },
        {
          "insert": "packages/framework",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " — standing agent knowledge loads from the corpus, never from standards files here."
        }
      ],
      "children": []
    },
