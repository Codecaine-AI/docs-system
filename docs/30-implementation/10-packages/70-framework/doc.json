    "b-fw-runtime-w": {
      "id": "b-fw-runtime-w",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Why: The package is versioned content — a delivery unit, not a runtime wall; installing, removing, or relocating it must not change storage, serving, rendering, editing, or CLI behavior. The manual instructs agents when to use the CLI, workbench, and server API but implements none of those surfaces. Rejected alternative — unpackaging into plain repository content — is recorded on the "
        },
        {
          "insert": "Packages",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "30-implementation/10-packages",
              "label": "Packages"
            }
          }
        },
        {
          "insert": " page."
        }
      ],
      "children": []
    },
