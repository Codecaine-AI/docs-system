    "mcp-jev-cache-1": {
      "id": "mcp-jev-cache-1",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Answers stay in memory, keyed by model, rule ID, and the question's state. A "
        },
        {
          "insert": "docs_check",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " after a write reuses the answers for unchanged blocks."
        }
      ],
      "children": []
    },
    "mcp-jev-cache-2": {
      "id": "mcp-jev-cache-2",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "The cache holds up to 5,000 answers and drops the oldest first."
        }
      ],
      "children": []
    },
    "mcp-jev-timeout": {
