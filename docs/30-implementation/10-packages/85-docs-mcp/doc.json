    "mcp-jev-lead": {
      "id": "mcp-jev-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "jev-engine.ts implements "
        },
        {
          "insert": "JudgmentEngine",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " over the TypeSafe System One HTTP API. It asks each rule about each block the rule applies to, one question per request, with up to 6 requests in flight."
        }
      ],
      "children": []
    },
