      },
      "text": [
        {
          "insert": "Compatibility"
        }
      ],
      "children": []
    },
    "mcp-guide-14": {
      "id": "mcp-guide-14",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The snapshot command records package source hashes, repository revisions, tool contracts, and guidance sources. Standards reload between tasks. The managed host rebuilds runtime source automatically and waits for active tasks and editor leases before replacement. Standalone daemons require a manual restart after imported implementation changes. Docs Lab and docs-writer retain their staged review behavior."
        }
      ],
      "children": []
    },
    "mcp-guide-15": {
      "id": "mcp-guide-15",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Content and component edits expose guarded undo while the service is running. Page creation does not expose undo because the existing tree inverse cannot safely remove a page after later additions."
        }
      ],
      "children": []
    },
    "maintenance-0": {
      "id": "maintenance-0",
      "type": "heading",
