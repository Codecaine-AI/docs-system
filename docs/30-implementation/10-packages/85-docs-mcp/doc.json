    "mcp-jev-timeout-1": {
      "id": "mcp-jev-timeout-1",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "One 4-second deadline covers the whole judge call. A 429 or 529 response is retried once."
        }
      ],
      "children": []
    },
    "mcp-jev-timeout-2": {
      "id": "mcp-jev-timeout-2",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Any other failure makes judgment unavailable, and both callers fail open."
        }
      ],
      "children": []
    },
