    "mcp-guide-0": {
      "id": "mcp-guide-0",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The Docs MCP package connects external coding agents to the existing Docs service. Codex and Claude Code use an MCP stdio connection. pi Agent uses an extension that forwards the same tool definitions."
        }
      ],
      "children": []
    },
    "mcp-guide-1": {
      "id": "mcp-guide-1",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Read and Edit"
        }
      ],
      "children": []
    },
    "mcp-guide-2": {
      "id": "mcp-guide-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Discover the active workspace with "
        },
        {
          "insert": "docs_discover",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Call "
        },
        {
          "insert": "docs_begin",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " before editing. It returns a task ID, the style digest, a guidance topic index, and one-line component purposes. Read "
        },
        {
          "insert": "docs_guidance",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " topic "
        },
        {
          "insert": "style",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " with that task ID next, because the service refuses content writes until the task has read it. Then read the target through "
        },
        {
          "insert": "docs_read",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and pass its revision hash and the task ID to a typed editing tool. Valid changes apply immediately."
        }
      ],
      "children": []
    },
    "mcp-guide-3": {
      "id": "mcp-guide-3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The service rejects invalid structure and stale revisions. Tree, annotation, review-decision, asset, undo, restore, and lint-fix tools skip the style-read requirement. A write result opens with "
        },
        {
          "insert": "style_findings",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for the blocks the write touched, "
        },
        {
          "insert": "style_gate_open",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for violations the task left open on the page, and "
        },
        {
          "insert": "next",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", before the document. A failed update in one project does not roll back successful updates in another project."
        }
      ],
      "children": []
    },
    "mcp-guide-check": {
      "id": "mcp-guide-check",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Run "
        },
        {
          "insert": "docs_check",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " with the task ID on each changed page before reporting completion. It fails on required findings and on gated style warnings the task introduced, which it lists in "
        },
        {
          "insert": "style_gate",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Repair them or state what remains unresolved. "
        },
        {
          "insert": "Authoring Lints",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/10-doc-standards/80-authoring-lints"
            }
          }
        },
        {
          "insert": " defines the gated rules and the task baseline."
        }
      ],
      "children": []
    },
    "mcp-guide-judgment": {
      "id": "mcp-guide-judgment",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Write feedback comes from deterministic lint plus three judgment rules. lint-feedback.ts holds "
        },
        {
          "insert": "STYLE_RULE_POLICY",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", which selects the gated warnings, and "
        },
        {
          "insert": "judgmentRules",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", which Authoring Lints describes. jev-engine.ts answers those rules."
        }
      ],
      "children": []
    },
    "mcp-jev-h": {
      "id": "mcp-jev-h",
      "type": "heading",
