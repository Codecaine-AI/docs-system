      "children": []
    },
    "pdf-workbench-2": {
      "id": "pdf-workbench-2",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Why: Reusing the viewer retains typed block rendering while print-specific transformations handle pagination and content that cannot remain interactive. pdf-lib joins PDFs and adds combined page numbers. fflate packages per-page PDFs under the paths computed by "
        },
        {
          "insert": "pdf-selection.ts",
          "attributes": {
