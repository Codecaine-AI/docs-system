    "b-wb-catalog-w": {
      "id": "b-wb-catalog-w",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Why: A host-local catalog was rejected. It drifts from the model registry and the design vocabulary the moment a block changes."
        }
      ],
      "children": []
    },
    "b-wb-catalog-a": {
      "id": "b-wb-catalog-a",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Applies to: "
        },
        {
          "insert": "packages/docs-workbench",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Future block UI reads the model registries and design docs, never a host copy."
        }
      ],
      "children": []
    },
    "b-wb-static-h": {
      "id": "b-wb-static-h",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "Static export is read-only by construction"
