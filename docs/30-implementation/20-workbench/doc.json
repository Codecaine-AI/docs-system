      "children": []
    },
    "pdf-workbench-3": {
      "id": "pdf-workbench-3",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Applies to: Future export formats under "
        },
        {
          "insert": "packages/docs-workbench/web/src/lib",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "packages/docs-workbench/web/src/lib"
            }
          }
        },
        {
          "insert": " and the export dialog must use saved bundles without mutating source documents."
        }
      ],
      "children": []
    },
    "pdf-workbench-4": {
      "id": "pdf-workbench-4",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "PDF Rendering Belongs to the Live Host"
        }
      ],
      "children": []
    },
    "pdf-workbench-5": {
      "id": "pdf-workbench-5",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Decision: "
        },
        {
          "insert": "pdf-export.ts",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "packages/docs-workbench/src/pdf-export.ts"
            }
          }
        },
        {
          "insert": " handles POST /api/export-pdf in the standalone host and in "
        },
        {
          "insert": "managed-runtime.ts",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "packages/docs-mcp/src/managed-runtime.ts"
            }
          }
        },
        {
          "insert": " for central project routes. It launches an isolated Chromium context with author JavaScript, service workers, and network requests disabled."
        }
      ],
      "children": []
    },
    "pdf-workbench-6": {
      "id": "pdf-workbench-6",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Why: Browser printing retains selectable text and browser layout while keeping credentials and project filesystem reads out of the printer. The client supplies self-contained HTML. Playwright resolves at runtime because its browser resources cannot be included in the central service's single-file bundle."
        }
      ],
      "children": []
    },
    "pdf-workbench-7": {
      "id": "pdf-workbench-7",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Applies to: Both route mounts use the same handler. It bounds each request to 20 MiB, allows one active render per runtime, closes the browser after completion, and enforces a 60-second post-launch deadline. Embedded HTML frames above 970 CSS pixels fail before printing."
        }
      ],
      "children": []
    },
