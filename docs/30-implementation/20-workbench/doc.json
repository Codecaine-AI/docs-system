    "b-wb-thin-h": {
      "id": "b-wb-thin-h",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "The workbench is a thin composition host"
        }
      ],
      "children": []
    },
    "b-wb-thin-d": {
      "id": "b-wb-thin-d",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Decision: Capabilities live in docs-viewer and docs-server; the workbench composes them and supplies the callbacks, data, persistence, locks, uploads, navigation, embeds, without defining block rendering, editor semantics, or write rules of its own."
        }
      ],
      "children": []
    },
    "b-wb-thin-w": {
      "id": "b-wb-thin-w",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Why: Reimplementing interactions in the host was rejected. A second implementation drifts from the packages and breaks every other host that embeds them."
        }
      ],
      "children": []
    },
    "b-wb-thin-a": {
      "id": "b-wb-thin-a",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Applies to: "
        },
        {
          "insert": "packages/docs-workbench",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Every future host page and shell feature stays composition glue."
        }
      ],
      "children": []
    },
    "b-wb-input-h": {
      "id": "b-wb-input-h",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "Editor-owned input stays inside the viewer"
        }
      ],
      "children": []
    },
    "b-wb-input-d": {
      "id": "b-wb-input-d",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Decision: Link authoring, keyboard behavior, paste conversion, and slash insertion live inside docs-viewer's editor extensions; the workbench receives document updates through the host callbacks rather than intercepting input."
        }
      ],
      "children": []
    },
    "b-wb-input-w": {
      "id": "b-wb-input-w",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Why: One interaction implementation serves every host; host-side input handling was rejected because it duplicates editor behavior per host."
        }
      ],
      "children": []
    },
    "b-wb-input-a": {
      "id": "b-wb-input-a",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Applies to: "
        },
        {
          "insert": "packages/docs-viewer/src/editor",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "packages/docs-workbench/web/src/pages",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Future input features land as viewer extensions."
        }
      ],
      "children": []
    },
    "b-wb-catalog-h": {
      "id": "b-wb-catalog-h",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "No parallel block catalog"
        }
      ],
      "children": []
    },
