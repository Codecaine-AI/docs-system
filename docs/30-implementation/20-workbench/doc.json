      "id": "pdf-workbench-1",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Decision: "
        },
        {
          "insert": "ExportDialog.tsx",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "packages/docs-workbench/web/src/shell/ExportDialog.tsx"
