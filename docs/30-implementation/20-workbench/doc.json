        {
          "insert": "packages/docs-workbench/web/src/data/api.ts",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "packages/docs-workbench/web/src/data/api.ts"
            }
          }
        },
        {
          "insert": ", the reduced "
        },
        {
          "insert": "DocsClient",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " wiring in "
        },
        {
          "insert": "packages/docs-workbench/web/src/data/client.ts",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "packages/docs-workbench/web/src/data/client.ts"
            }
          }
        },
        {
          "insert": ", and the page selection over "
        },
        {
          "insert": "packages/docs-workbench/src/export.ts",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "packages/docs-workbench/src/export.ts"
            }
          }
        },
        {
          "insert": " must agree on the same capability set."
        }
      ],
      "children": []
    },
    "b-wb-static-w": {
      "id": "b-wb-static-w",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Why: Runtime capability flags alone were rejected. An export that merely hides write UI but still ships write paths can drift; omitting the endpoints makes the read-only guarantee structural."
        }
      ],
      "children": []
    },
