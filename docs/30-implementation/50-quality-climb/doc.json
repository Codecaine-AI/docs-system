      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "write.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " starts one Claude Code run per brief, with Opus 5.5 at medium effort. Each run writes one page in its own scratch corpus, with only the docs MCP tools and Read on the brief's sources. The writer reads each repo-relative source as of commit "
        },
        {
          "insert": "ef186cd4",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "SOURCE_REF",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in "
        },
        {
          "insert": "write.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". At most 3 runs go at once unless you pass "
        },
        {
          "insert": "--concurrency",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
