    "intro": {
      "id": "intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The quality climb measures how well a fixed AI writer documents this codebase with the docs tools. Its code is in "
        },
        {
          "insert": "evals/quality-climb/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Each round writes, renders and scores the same page briefs. Between rounds, a builder agent changes the viewer, the guidance, the tool text or the lints from the judges' findings."
        }
      ],
      "children": []
    },
    "h-what": {
      "id": "h-what",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "What the Climb Is"
        }
      ],
      "children": []
    },
    "what-lead": {
      "id": "what-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "One round runs 4 steps in order. "
        },
        {
          "insert": "round.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " skips a step whose output already exists, so a round that crashes resumes where it stopped."
        }
      ],
      "children": []
    },
    "what-outline": {
      "id": "what-outline",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Quality Climb Round",
            "steps": [
              {
                "text": "Write Each Page",
                "steps": [
                  {
                    "text": "The writer, Opus 5.5 at medium effort, writes each brief's page with only the docs MCP tools"
                  },
                  {
                    "text": "Each writer works in its own scratch corpus, with repo sources frozen at commit 8003057"
                  }
                ]
              },
              {
                "text": "Render Each Page",
                "steps": [
                  {
                    "text": "render.ts exports the page with docs-cli export and takes a 1280px Playwright PNG"
                  },
                  {
                    "text": "render.ts saves the markdown, the scorable blocks and the docs_check lint findings"
                  }
                ]
              },
              {
                "text": "Judge Each Page",
                "steps": [
                  {
                    "text": "Each judge scores the PNG, the markdown and the source in 8 categories and per block"
                  },
                  {
                    "text": "Sol scores each page 3 times and Opus once"
                  }
                ]
              },
              {
                "text": "Gate the Round",
                "steps": [
                  {
                    "text": "gate.ts compares the median scores and the guards with the baseline round"
                  }
                ]
              }
            ]
          }
        ]
      },
      "children": []
    },
    "what-builder": {
      "id": "what-builder",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The builder commits one fix for each finding it acts on. It reads only the climb set, so the held-out set shows whether a fix helps pages it was not made for."
        }
      ],
      "children": []
    },
