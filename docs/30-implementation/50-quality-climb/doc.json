    "lane-gate": {
      "id": "lane-gate",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A lane judge gives each criterion one score over all of the lane's blocks on a page, and scores the 8 page categories as a guard. A criterion's score is the median of a judge's samples of a page, then the mean over the pages of a set. A lane passes only when every counting judge gives a mean of 9.5 or more on every criterion, on both the climb set and the held-out set."
        }
      ],
      "children": []
