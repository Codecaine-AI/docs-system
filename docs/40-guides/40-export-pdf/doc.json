    "pdf-guide-0": {
      "id": "pdf-guide-0",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Use Export to download saved Docs pages as PDFs. This guide covers choosing pages, selecting a download format, checking the embedded fonts, and recovering from export errors."
        }
      ],
      "children": []
    },
    "pdf-guide-1": {
      "id": "pdf-guide-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The "
        },
        {
          "insert": "Reading Surface",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/50-editor-design/10-reading-surface"
            }
          }
        },
        {
          "insert": " defines export behavior. "
        },
        {
          "insert": "Workbench",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "30-implementation/20-workbench"
            }
          }
        },
        {
          "insert": " maps that behavior to the renderer and server."
        }
      ],
      "children": []
    },
    "pdf-guide-2": {
      "id": "pdf-guide-2",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Export Selected Pages"
        }
      ],
      "children": []
    },
    "pdf-guide-3": {
      "id": "pdf-guide-3",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Wait for the document's save indicator to show Saved."
        }
      ],
      "children": []
    },
    "pdf-guide-4": {
      "id": "pdf-guide-4",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Click Export beside Docs at the top of the sidebar."
        }
      ],
      "children": []
    },
    "pdf-guide-5": {
      "id": "pdf-guide-5",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Choose pages in the tree. Use a folder checkbox for its descendants or Select section for a parent page and its descendants."
        }
      ],
      "children": []
    },
    "pdf-guide-6": {
      "id": "pdf-guide-6",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Choose the download format below."
        }
      ],
      "children": []
    },
    "pdf-guide-7": {
      "id": "pdf-guide-7",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Click Export. Keep the dialog open until the downloads are ready."
        }
      ],
      "children": []
    },
    "pdf-guide-8": {
      "id": "pdf-guide-8",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Choose a Download Format"
        }
      ],
      "children": []
    },
    "pdf-guide-9": {
      "id": "pdf-guide-9",
      "type": "structured-table",
      "props": {
        "columns": [
          "Format",
          "Download",
          "Use It When"
        ],
        "rows": [
          [
            "ZIP of PDFs",
            "docs-pdfs.zip, with one PDF per selected docs page and numbered folder paths preserved.",
            "You want a portable collection with its hierarchy. This is the default."
          ],
          [
            "One combined PDF",
            "docs.pdf, with each docs page starting on a new sheet and continuous page numbering.",
            "You want one file to read or share."
          ],
          [
            "Separate PDF files",
            "One PDF per docs page, with a sequence number before each filename.",
            "You want individual files without extracting a ZIP."
          ]
        ]
      },
      "children": []
    },
    "pdf-guide-10": {
      "id": "pdf-guide-10",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A docs page can span multiple PDF sheets. Export order follows the sidebar. A ZIP can contain both 10-guide.pdf and 10-guide/20-setup.pdf when a selected parent page also has selected children."
        }
      ],
      "children": []
    },
    "pdf-guide-11": {
      "id": "pdf-guide-11",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Retrieve the Downloads"
        }
      ],
      "children": []
    },
    "pdf-guide-12": {
      "id": "pdf-guide-12",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "If the browser blocks automatic downloads, use the download links in the completed dialog. For separate PDFs, allow multiple downloads when prompted. Download links remain available while the dialog stays open."
        }
      ],
      "children": []
    },
    "pdf-guide-13": {
      "id": "pdf-guide-13",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Prepare Content for Printing"
        }
      ],
      "children": []
    },
    "pdf-guide-14": {
      "id": "pdf-guide-14",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Select at most 100 docs pages per export. Wait for saves to finish because export reads saved content without flushing the editor."
        }
      ],
      "children": []
    },
    "pdf-guide-15": {
      "id": "pdf-guide-15",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Save Canvas and Sequence diagrams as document sidecars. Studio-only references without saved sidecars cannot export."
        }
      ],
      "children": []
    },
    "pdf-guide-16": {
      "id": "pdf-guide-16",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Store images in Docs. The printer cannot fetch external resources. Videos become a note directing readers to the live page."
        }
      ],
      "children": []
    },
    "pdf-guide-17": {
      "id": "pdf-guide-17",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Keep embedded HTML self-contained. Scripts do not run during printing. Split an HTML block if export reports that it exceeds one PDF sheet."
        }
      ],
      "children": []
    },
    "pdf-fonts-h": {
      "id": "pdf-fonts-h",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Fonts and Diagrams in the PDF"
        }
      ],
      "children": []
    },
    "pdf-fonts-lead": {
      "id": "pdf-fonts-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Every PDF prints text in Inter and code in IBM Plex Mono, the faces the "
        },
        {
          "insert": "layout lints",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/10-doc-standards/80-authoring-lints"
            }
          }
        },
        {
          "insert": " measure with. Theme and style rail font choices do not apply to print. Export embeds the font files each page uses, so the printer needs no network access and no installed fonts."
        }
      ],
      "children": []
    },
    "pdf-fonts-diagrams": {
      "id": "pdf-fonts-diagrams",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Canvas and Sequence diagrams print as inline SVG, so their labels use the same embedded faces as the text around them."
        }
      ],
      "children": []
    },
    "pdf-fonts-missing": {
      "id": "pdf-fonts-missing",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "If a font file does not download within 10 seconds, the page prints without it. The completed dialog lists each face it could not embed, such as "
        },
        {
          "insert": "IBM Plex Mono 600",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and text in that face uses a fallback font."
        }
      ],
      "children": []
    },
    "pdf-check-h": {
      "id": "pdf-check-h",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Check the Embedded Fonts"
        }
      ],
      "children": []
    },
    "pdf-check-lead": {
      "id": "pdf-check-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Use "
        },
        {
          "insert": "pdffonts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " from Poppler to list the fonts a downloaded PDF embeds."
        }
      ],
      "children": []
    },
    "pdf-check-1": {
      "id": "pdf-check-1",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "On macOS, install Poppler with "
        },
        {
          "insert": "brew install poppler",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "pdf-check-2": {
      "id": "pdf-check-2",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Run "
        },
        {
          "insert": "pdffonts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " on the downloaded file, for example "
        },
        {
          "insert": "pdffonts docs.pdf",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "pdf-check-3": {
      "id": "pdf-check-3",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Check that the "
        },
        {
          "insert": "name",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " column lists Inter and IBM Plex Mono faces, such as "
        },
        {
          "insert": "Inter-Regular",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "IBMPlexMono",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and that the "
        },
        {
          "insert": "emb",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " column shows "
        },
        {
          "insert": "yes",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for each."
        }
      ],
      "children": []
    },
    "pdf-check-notes": {
      "id": "pdf-check-notes",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Each name starts with a six-letter subset tag, such as "
        },
        {
          "insert": "AAAAAA+",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Page numbers can add one more face. Chromium draws the footer of a ZIP or separate PDF with an installed font, such as "
        },
        {
          "insert": ".SFNS-Regular",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " on macOS, because the footer cannot use the page's embedded faces. A combined PDF numbers its pages in Helvetica, a standard PDF font that is not embedded."
        }
      ],
      "children": []
    },
    "pdf-guide-18": {
      "id": "pdf-guide-18",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Recover From an Export Error"
        }
      ],
      "children": []
    },
    "pdf-guide-19": {
      "id": "pdf-guide-19",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A 404 from the PDF export request means the server handling that window has no export route. Refreshing a window connected to an older backend does not install the missing route."
        }
      ],
      "children": []
    },
    "pdf-guide-20": {
      "id": "pdf-guide-20",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "For central Docs, use "
        },
        {
          "insert": "Run the Central Docs Service",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "40-guides/30-run-central-docs"
            }
          }
        },
        {
          "insert": " to check update status. A backend waiting for authoring tasks cannot activate until those tasks and active draft locks are released. Finish the owning tasks normally. Coordinate any restart with their owners rather than interrupting active work. For a standalone server, rebuild and restart that server with the updated source."
        }
      ],
      "children": []
    },
    "pdf-guide-21": {
      "id": "pdf-guide-21",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "If Chromium is missing, run bunx playwright install chromium from packages/docs-workbench, then retry. The printer also tries an installed Google Chrome browser when bundled Chromium cannot start."
        }
      ],
      "children": []
    },
    "pdf-guide-22": {
      "id": "pdf-guide-22",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "For a 429 response, wait for the other PDF render to finish. For a 413 response, reduce the page's embedded image or HTML payload. The request limit is 20 MiB per docs page. A failed batch does not offer a partial archive; correct the reported issue and export again."
        }
      ],
      "children": []
    },
    "pdf-guide-23": {
      "id": "pdf-guide-23",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The sidebar export button requires a live Docs server. The docs-cli export command creates a static website with Markdown copies. That website does not provide PDF generation."
        }
      ],
      "children": []
    }
  }
}
