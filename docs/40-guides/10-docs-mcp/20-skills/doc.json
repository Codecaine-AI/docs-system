    "maintenance-9": {
      "id": "maintenance-9",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The server advertises tools and five startup instruction lines. It has no MCP prompts capability. Guidance is split into topics so a result stays small enough for a client to show inline."
        }
      ],
      "children": []
    },
