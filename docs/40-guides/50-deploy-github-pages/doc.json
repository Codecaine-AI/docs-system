      "type": "code",
      "props": {
        "language": "bash"
      },
      "text": [
        {
          "insert": "mkdir /tmp/objectives-ghpages && cd /tmp/objectives-ghpages\ncp -R /tmp/objectives-pages/. . && touch .nojekyll\ngit init -b gh-pages && git add -A && git commit -m \"Deploy objectives docs (static export of main <sha>)\"\ngit remote add origin https://github.com/Lascari-AI/objectives.git && git push -u origin gh-pages"
        }
