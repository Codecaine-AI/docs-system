    "ghp-s4-p": {
      "id": "ghp-s4-p",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Copy the export into a standalone repository and push it as "
        },
        {
          "insert": "gh-pages",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Git 2.41 lacks "
        },
        {
          "insert": "git worktree add --orphan",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", so a separate repository keeps the branch free of source history."
        }
